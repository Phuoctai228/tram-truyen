@startuml sq_send_notification
<style>
    sequenceDiagram{
        FontSize 16
        LineColor black

        arrow {
            ' Set the maximum width of the text on arrows
            MaximumWidth 300
            LineColor black
        }
        actor{
            BackgroundColor white
            LineColor black
            LineThickness 1.0
        }
        participant{
            BackgroundColor white
            LineColor black
            RoundCorner 0
        }
        database{
            BackgroundColor white
            LineColor black
        }
        lifeLine{
            LineColor black
        }
        group{
            LineColor black
        }
        groupHeader{
            BackgroundColor white
            LineColor black
        }
        referenceHeader{
            BackgroundColor white
            LineColor black
        }
        reference{
            BackgroundColor white
            LineColor black
        }
    }
</style>

hide footbox
mainframe Send Notification (UC-44)

actor Admin as adm
participant "SendNotificationPage" as view
participant "NotificationAdminController" as ctrl <<controller>>
participant ":NotificationService" as svc
participant ":Notification" as notif_ett
participant ":SystemAuditLog" as audit_ett
participant ":UserRepository" as user_repo
participant ":NotificationRepository" as notif_repo
participant ":SystemAuditLogRepository" as audit_repo
database Database as db

adm ++

opt Scope is "SPECIFIC" and admin searches recipient
    adm -> view++: Type keyword in search box
    view -> ctrl--: GET /admin/notifications/search-users?q=keyword
    activate ctrl

    ctrl -> svc++: searchRecipients(keyword)
    svc -> user_repo++: findTop10ByFullNameContainingIgnoreCaseOrEmailContainingIgnoreCase(keyword, keyword)
    user_repo -> db++: Execute search query
    db -->> user_repo: Return user matches
    db--
    user_repo -->> svc: Return user list
    user_repo--
    svc -->> ctrl--: Return List~UserRecipientDTO~

    ctrl -->> view--: Return 200 OK (List~UserRecipientDTO~)
    activate view
    view -->> adm: Display auto-complete suggestion list
    deactivate view
end

adm -> view++: Fill notification form and click "Gửi thông báo"
view -> ctrl--: POST /admin/notifications/send (SendNotificationRequest)
activate ctrl

opt Validation error (empty title or content)
    ctrl -->> view: Redirect /admin/notifications with errorMessage
    activate view
    view -->> adm: Display validation error alert
    deactivate view
end

ctrl -> ctrl++: getAdminId(authentication)
ctrl--

ctrl -> ctrl++: getClientIp(httpRequest)
ctrl--

ctrl -> svc++: sendNotification(adminId, request, clientIp)

alt Scope == "SPECIFIC"
    svc -> user_repo++: findById(recipientId)
    user_repo -> db++: Execute query
    db -->> user_repo: Return user data
    db--
    user_repo -->> svc: Return recipient entity
    user_repo--
else Scope == "ALL"
    svc -> svc++: Set recipientUserId = null (broadcast)
    svc--
end

svc -> notif_ett++: Call Notification.builder()
notif_ett -->> svc--: Return notification entity

svc -> notif_repo++: save(notification)
notif_repo -> db++: Insert into notifications
db -->> notif_repo: Return saved notification
db--
notif_repo -->> svc: Return saved notification
notif_repo--

svc -> audit_ett++: Call SystemAuditLog.builder()
audit_ett -->> svc--: Return auditLog entity

svc -> audit_repo++: save(auditLog)
audit_repo -> db++: Insert into system_audit_logs
db -->> audit_repo: Return saved audit log
db--
audit_repo -->> svc: Return saved audit log
audit_repo--

svc -->> ctrl--: Return void

ctrl -->> view--: Redirect /admin/notifications with successMessage
deactivate ctrl
activate view
view -->> adm--: Display success toast and update recent history
deactivate view

deactivate adm

@enduml
