@startuml sq_forgot_password
<style>
    root {
        LineColor black
    }
    sequenceDiagram{
        LineColor black
        FontSize 16

        arrow {
            LineColor black
            ' Set the maximum width of the text on arrows
            MaximumWidth 300
        }
        actor{
            LineColor black
            BackgroundColor white
            LineThickness 1.0
        }
        participant{
            LineColor black
            BackgroundColor white
            RoundCorner 0
        }
        database{
            LineColor black
            BackgroundColor white
        }
        lifeLine{
            LineColor black
            BackgroundColor white
        }
        group{
            LineColor black
            BackgroundColor white
        }
        groupHeader{
            LineColor black
            BackgroundColor white
        }
        referenceHeader{
            LineColor black
            BackgroundColor white
        }
        reference{
            LineColor black
            BackgroundColor white
        }
    }
</style>
skinparam monochrome true


hide footbox
mainframe Forgot Password

actor Guest as act
participant "ForgotPasswordPage" as view
participant "ForgotVerifyOtpPage" as verify_view
participant "ResetPasswordPage" as reset_view
participant "LoginPage" as login_view
participant "AuthController" as ctrl <<controller>>
participant ":AuthService" as svc
participant ":PasswordEncoder" as encoder
participant ":EmailService" as email_svc
participant ":EmailVerificationToken" as token
participant ":UserRepository" as user_repo
participant ":EmailVerificationTokenRepository" as token_repo
database Database as db

act ++

act -> view++: Submit forgot password request
view -> ctrl++: POST /forgot-password

ctrl -> svc++: sendForgotPasswordOtp(email)

svc -> user_repo++: findByEmail(email)
user_repo -> db++: Execute query
db -->> user_repo: Return user data
db--
user_repo -->> svc: Return user entity
user_repo--

svc -> svc++: Validate user account and status
svc--
alt Email not found or account banned
    svc -->> ctrl: throw IllegalArgumentException
    ctrl -->> view: Return "authentication/forgot-password"
    view -->> act: Display error message
    deactivate view
else Valid local account
    svc -> token_repo++: deleteByUser(user)
    token_repo -> db++: Save changes to database
    db -->> token_repo: Return result
    db--
    token_repo -->> svc: Return result
    token_repo--

    svc -> svc++: Generate 6-digit OTP code
    svc--

    svc -> token++: Call EmailVerificationToken(user, otp)
    token -->> svc--: Return token entity

    svc -> token_repo++: save(token)
    token_repo -> db++: Save changes to database
    db -->> token_repo: Return saved token
    db--
    token_repo -->> svc: Return saved token
    token_repo--

    svc -> email_svc++: sendForgotPasswordOtpEmail(email, otp)
    email_svc -->> svc--: Return result

    svc -->> ctrl--: Return result
    ctrl -->> verify_view--: Redirect to /forgot-password/verify-otp
    activate verify_view
    verify_view -->> act: Display OTP verification page
end

act -> verify_view: Submit OTP code
verify_view -> ctrl++: POST /forgot-password/verify-otp

ctrl -> svc++: verifyForgotPasswordOtp(email, otpCode)

svc -> user_repo++: findByEmail(email)
user_repo -> db++: Execute query
db -->> user_repo: Return user data
db--
user_repo -->> svc: Return user entity
user_repo--

svc -> token_repo++: findByOtpCodeAndUser(otpCode, user)
token_repo -> db++: Execute query
db -->> token_repo: Return token data
db--
token_repo -->> svc: Return token entity
token_repo--

svc -> svc++: Validate OTP correctness and expiration
svc--
alt Invalid or expired OTP
    svc -->> ctrl: throw IllegalArgumentException
    ctrl -->> verify_view: Return "authentication/forgot-password-verify-otp"
    verify_view -->> act: Display OTP error message
    deactivate verify_view
else Valid OTP
    svc -->> ctrl--: Return result
    ctrl -> ctrl++: Save email to session
    ctrl--
    ctrl -->> reset_view--: Redirect to /forgot-password/reset
    activate reset_view
    reset_view -->> act: Display reset password form
end

act -> reset_view: Submit new password
reset_view -> ctrl++: POST /forgot-password/reset

ctrl -> ctrl++: Validate passwords match
ctrl--
opt Passwords do not match
    ctrl -->> reset_view: Return "authentication/reset-password"
    reset_view -->> act: Display password mismatch error message
end

ctrl -> svc++: resetPassword(email, newPassword)

svc -> svc++: Validate password strength
svc--
alt Weak password
    svc -->> ctrl: throw IllegalArgumentException
    ctrl -->> reset_view: Return "authentication/reset-password"
    reset_view -->> act: Display error message
    deactivate reset_view
else Valid new password
    svc -> user_repo++: findByEmail(email)
    user_repo -> db++: Execute query
    db -->> user_repo: Return user data
    db--
    user_repo -->> svc: Return user data
    user_repo--

    svc -> encoder++: encode(newPassword)
    encoder -->> svc--: Return encodedPassword

    svc -> user_repo++: save(user)
    user_repo -> db++: Save changes to database
    db -->> user_repo: Return saved user
    db--
    user_repo -->> svc: Return saved user
    user_repo--

    svc -> token_repo++: deleteByUser(user)
    token_repo -> db++: Save changes to database
    db -->> token_repo: Return result
    db--
    token_repo -->> svc: Return result
    token_repo--

    svc -->> ctrl--: Return result
    ctrl -->> login_view--: Redirect to /login
    activate login_view
    login_view -->> act--: Display login page with success message
end

@enduml
