@startuml sq_change_password
<style>
    root {
        LineColor black
    }
    sequenceDiagram{
        LineColor black
        FontSize 16

        arrow {
            LineColor black
            ' Set the maximum width of the text on arrows
            MaximumWidth 300
        }
        actor{
            LineColor black
            BackgroundColor white
            LineThickness 1.0
        }
        participant{
            LineColor black
            BackgroundColor white
            RoundCorner 0
        }
        database{
            LineColor black
            BackgroundColor white
        }
        lifeLine{
            LineColor black
            BackgroundColor white
        }
        group{
            LineColor black
            BackgroundColor white
        }
        groupHeader{
            LineColor black
            BackgroundColor white
        }
        referenceHeader{
            LineColor black
            BackgroundColor white
        }
        reference{
            LineColor black
            BackgroundColor white
        }
    }
</style>
skinparam monochrome true


hide footbox
mainframe Change Password

actor Member as act
participant "ChangePasswordPage" as view
participant "ProfilePage" as r_view
participant "LoginPage" as login_view
participant "UserController" as ctrl <<controller>>
participant ":UserService" as svc
participant ":PasswordEncoder" as encoder
participant ":UserRepository" as user_repo
database Database as db

act ++

act -> view++: Submit change password form
view -> ctrl++: POST /user/change-password

ctrl -> ctrl++: Check authentication status
ctrl--
opt User is not authenticated
    ctrl -->> login_view: Redirect to /login?redirect=/user/change-password
    activate login_view
    login_view -->> act: Display login page
    deactivate login_view
end

ctrl -> svc++: changePassword(email, oldPassword, newPassword)

svc -> user_repo++: findByEmail(email)
user_repo -> db++: Execute query
db -->> user_repo: Return user data
db--
user_repo -->> svc: Return user entity
user_repo--

svc -> encoder++: matches(oldPassword, encodedPassword)
encoder -->> svc--: Return isMatched

svc -> svc++: Validate current password match
svc--
alt Incorrect current password
    svc -->> ctrl: throw IllegalArgumentException
    ctrl -->> view: Redirect to /user/change-password
    view -->> act: Display error message
    deactivate view
else Valid current password
    svc -> encoder++: encode(newPassword)
    encoder -->> svc--: Return encodedPassword

    svc -> user_repo++: save(user)
    user_repo -> db++: Save changes to database
    db -->> user_repo: Return saved user
    db--
    user_repo -->> svc: Return saved user
    user_repo--

    svc -->> ctrl--: Return result
    ctrl -->> r_view--: Redirect to /user/profile
    activate r_view
    r_view -->> act--: Display profile with success message
end

@enduml
