@startuml sq_uc32_daily_checkin
<style>
    sequenceDiagram{
        FontSize 16

        arrow {
            ' Set the maximum width of the text on arrows
            MaximumWidth 300
        }
        actor{
            BackgroundColor white
            LineThickness 1.0
        }
        participant{
            BackgroundColor white
            RoundCorner 0
        }
        database{
            BackgroundColor white
        }
        groupHeader{
            BackgroundColor white
        }
        referenceHeader{
            BackgroundColor white
        }
        reference{
            BackgroundColor white
        }
    }
</style>

hide footbox
mainframe Daily Check-in

actor Member as act
participant "DailyCheckinPage" as view
participant "LoginPage" as r_view
participant "UserController" as ctrl <<controller>>
participant ":DailyCheckinService" as checkin_svc
participant ":WalletService" as wallet_svc
participant ":DailyCheckinStatusDTO" as status_dto
participant ":UserDailyCheckin" as checkin_ett
participant ":Transaction" as tx_ett
participant ":DailyCheckinResultDTO" as result_dto
participant ":UserRepository" as user_repo
participant ":UserDailyCheckinRepository" as checkin_repo
participant ":TransactionRepository" as tx_repo
database Database as db

act ++

act -> view++: Access daily check-in page
view -> ctrl++: GET /user/checkin

ctrl -> ctrl++: Check authentication status
ctrl--
opt User is not authenticated
    ctrl -->> r_view: Redirect to /login?redirect=/user/checkin
    activate r_view
    r_view -->> act: Display login page
    deactivate r_view
end

ctrl -> checkin_svc++: getCheckinStatus(email)

checkin_svc -> user_repo++: findByEmail(email)
user_repo -> db++: Execute query
db -->> user_repo: Return user data
db--
user_repo -->> checkin_svc: Return user entity
user_repo--

checkin_svc -> checkin_repo++: findByUserAndCheckinDate(user, today)
checkin_repo -> db++: Execute query
db -->> checkin_repo: Return todayCheckin data
db--
checkin_repo -->> checkin_svc: Return todayCheckin
checkin_repo--

checkin_svc -> checkin_repo++: findTopByUserOrderByCheckinDateDesc(user)
checkin_repo -> db++: Execute query
db -->> checkin_repo: Return latestCheckin data
db--
checkin_repo -->> checkin_svc: Return latestCheckin
checkin_repo--

checkin_svc -> checkin_repo++: countByUser(user)
checkin_repo -> db++: Execute query
db -->> checkin_repo: Return totalCheckinDays
db--
checkin_repo -->> checkin_svc: Return totalCheckinDays
checkin_repo--

checkin_svc -> checkin_svc++: Calculate streak cycle and build 7-day reward roadmap
checkin_svc--

checkin_svc -> status_dto++: Call DailyCheckinStatusDTO(streakCount, todayReward, roadmap)
status_dto -->> checkin_svc--: Return checkinStatusDTO

checkin_svc -->> ctrl--: Return checkinStatusDTO

ctrl -->> view--: Return "user/checkin"
view -->> act: Display check-in status and 7-day reward roadmap

act -> view: Click "Điểm danh nhận ngay"
view -> ctrl++: POST /user/checkin

ctrl -> checkin_svc++: performCheckin(email)

checkin_svc -> user_repo++: findByEmail(email)
user_repo -> db++: Execute query
db -->> user_repo: Return user data
db--
user_repo -->> checkin_svc: Return user entity
user_repo--

checkin_svc -> checkin_repo++: existsByUserAndCheckinDate(user, today)
checkin_repo -> db++: Execute query
db -->> checkin_repo: Return boolean result
db--
checkin_repo -->> checkin_svc: Return alreadyCheckedIn
checkin_repo--

checkin_svc -> checkin_svc++: Check if user already checked in today
checkin_svc--
alt Already checked in today
    checkin_svc -->> ctrl: throw DuplicateResourceException
    ctrl -->> view: Redirect to /user/checkin
    view -->> act: Display already checked-in warning message
else Not checked in today
    checkin_svc -> checkin_repo++: findTopByUserOrderByCheckinDateDesc(user)
    checkin_repo -> db++: Execute query
    db -->> checkin_repo: Return latestCheckin data
    db--
    checkin_repo -->> checkin_svc: Return latestCheckin
    checkin_repo--

    checkin_svc -> checkin_svc++: Calculate newStreak and rewardCoins (+5 to +30 Coin)
    checkin_svc--

    checkin_svc -> checkin_ett++: Call UserDailyCheckin(user, today, rewardCoins, newStreak)
    checkin_ett -->> checkin_svc--: Return checkin entity

    checkin_svc -> checkin_repo++: save(checkin)
    checkin_repo -> db++: Save changes to database
    db -->> checkin_repo: Return saved checkin
    db--
    checkin_repo -->> checkin_svc: Return saved checkin
    checkin_repo--

    checkin_svc -> wallet_svc++: addCoins(user, rewardCoins, "GIFT_COIN", checkinId, description)

    wallet_svc -> user_repo++: findByIdWithLock(userId)
    user_repo -> db++: Execute query
    db -->> user_repo: Return locked user data
    db--
    user_repo -->> wallet_svc: Return lockedUser entity
    user_repo--

    wallet_svc -> user_repo++: save(lockedUser)
    user_repo -> db++: Save changes to database
    db -->> user_repo: Return updated user
    db--
    user_repo -->> wallet_svc: Return updated user
    user_repo--

    wallet_svc -> tx_ett++: Call Transaction(lockedUser, rewardCoins, newBalance, "GIFT_COIN")
    tx_ett -->> wallet_svc--: Return transaction entity

    wallet_svc -> tx_repo++: save(tx)
    tx_repo -> db++: Save changes to database
    db -->> tx_repo: Return saved transaction
    db--
    tx_repo -->> wallet_svc: Return saved transaction
    tx_repo--

    wallet_svc -->> checkin_svc--: Return result

    checkin_svc -> wallet_svc++: getBalance(email)
    wallet_svc -> user_repo++: findByEmail(email)
    user_repo -> db++: Execute query
    db -->> user_repo: Return user entity
    db--
    user_repo -->> wallet_svc: Return user entity
    user_repo--
    wallet_svc -->> checkin_svc--: Return newBalance

    checkin_svc -> result_dto++: Call DailyCheckinResultDTO(rewardCoins, newStreak, newBalance)
    result_dto -->> checkin_svc--: Return dailyCheckinResultDTO

    checkin_svc -->> ctrl--: Return dailyCheckinResultDTO
    ctrl -->> view--: Redirect to /user/checkin
    view -->> act--: Display reward notification and updated Coin balance
end

@enduml
