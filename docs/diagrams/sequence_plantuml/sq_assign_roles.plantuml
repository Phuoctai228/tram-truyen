@startuml sq_assign_roles
<style>
    sequenceDiagram{
        FontSize 16
        LineColor black

        arrow {
            ' Set the maximum width of the text on arrows
            MaximumWidth 300
            LineColor black
        }
        actor{
            BackgroundColor white
            LineColor black
            LineThickness 1.0
        }
        participant{
            BackgroundColor white
            LineColor black
            RoundCorner 0
        }
        database{
            BackgroundColor white
            LineColor black
        }
        lifeLine{
            LineColor black
        }
        group{
            LineColor black
        }
        groupHeader{
            BackgroundColor white
            LineColor black
        }
        referenceHeader{
            BackgroundColor white
            LineColor black
        }
        reference{
            BackgroundColor white
            LineColor black
        }
    }
</style>

hide footbox
mainframe Assign Roles (UC-48)

actor Admin as adm
participant "UserListPage" as view
participant "UserAdminController" as ctrl <<controller>>
participant ":UserManagementService" as svc
participant ":UserRepository" as user_repo
participant ":RoleRepository" as role_repo
participant ":SystemAuditLog" as audit_ett
participant ":Notification" as notif_ett
participant ":SystemAuditLogRepository" as audit_repo
participant ":NotificationRepository" as notif_repo
database Database as db

adm ++

adm -> view++: Select user, check/uncheck Staff role and click "Xác nhận phân quyền"
view -> ctrl--: POST /admin/users/assign-role (AssignRoleRequest)
activate ctrl

ctrl -> ctrl++: getAdminId(authentication)
ctrl--

ctrl -> ctrl++: getClientIp(httpRequest)
ctrl--

ctrl -> svc++: assignRole(adminId, request, clientIp)

svc -> user_repo++: findById(userId)
user_repo -> db++: Execute query
db -->> user_repo: Return user data
db--
user_repo -->> svc: Return user entity
user_repo--

alt Target not active, is Admin, is Self, or Role unchanged
    svc -->> ctrl: Throw IllegalStateException / IllegalArgumentException
    ctrl -->> view: Redirect /admin/users with errorMessage
    activate view
    view -->> adm: Display role assignment error banner
    deactivate view
else Valid role change
    alt Grant Staff Role (hasStaffRole == true)
        svc -> role_repo++: findByName("ROLE_STAFF")
        role_repo -> db++: Execute query
        db -->> role_repo: Return staff role
        db--
        role_repo -->> svc: Return staff role
        role_repo--
        svc -> svc++: Add ROLE_STAFF to user.roles
        svc--
    else Revoke Staff Role (hasStaffRole == false)
        svc -> svc++: Remove ROLE_STAFF from user.roles
        svc--
    end

    svc -> user_repo++: save(user)
    user_repo -> db++: Update user_roles mapping table
    db -->> user_repo: Return saved user
    db--
    user_repo -->> svc: Return saved user
    user_repo--

    svc -> audit_ett++: Call SystemAuditLog.builder()
    audit_ett -->> svc--: Return auditLog entity

    svc -> audit_repo++: save(auditLog)
    audit_repo -> db++: Insert into system_audit_logs (actionType = "CHANGE_USER_ROLE")
    db -->> audit_repo: Return saved audit log
    db--
    audit_repo -->> svc: Return saved audit log
    audit_repo--

    svc -> notif_ett++: Call Notification.builder()
    notif_ett -->> svc--: Return notification entity

    svc -> notif_repo++: save(notification)
    notif_repo -> db++: Insert into notifications
    db -->> notif_repo: Return saved notification
    db--
    notif_repo -->> svc: Return saved notification
    notif_repo--

    svc -->> ctrl--: Return void

    ctrl -->> view--: Redirect /admin/users with successMessage
    deactivate ctrl
    activate view
    view -->> adm--: Display success toast and update user role badge in table
    deactivate view
end

deactivate adm

@enduml
