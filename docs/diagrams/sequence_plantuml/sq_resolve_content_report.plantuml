@startuml sq_resolve_content_report
<style>
    sequenceDiagram{
        FontSize 16
        LineColor black

        arrow {
            ' Set the maximum width of the text on arrows
            MaximumWidth 300
            LineColor black
        }
        actor{
            BackgroundColor white
            LineColor black
            LineThickness 1.0
        }
        participant{
            BackgroundColor white
            LineColor black
            RoundCorner 0
        }
        database{
            BackgroundColor white
            LineColor black
        }
        lifeLine{
            LineColor black
        }
        group{
            LineColor black
        }
        groupHeader{
            BackgroundColor white
            LineColor black
        }
        referenceHeader{
            BackgroundColor white
            LineColor black
        }
        reference{
            BackgroundColor white
            LineColor black
        }
    }
</style>

hide footbox
mainframe Resolve Content Report (UC-43)

actor "Admin / Staff" as adm
participant "ReportListPage" as view
participant "ReportAdminController" as ctrl <<controller>>
participant ":ReportService" as svc
participant ":ContentReportRepository" as rpt_repo
participant ":ChapterRepository" as ch_repo
participant ":Notification" as notif_ett
participant ":SystemAuditLog" as audit_ett
participant ":NotificationRepository" as notif_repo
participant ":SystemAuditLogRepository" as audit_repo
database Database as db

adm ++

adm -> view++: Select decision, action (DRAFT_CHAPTER / NO_CHANGE), enter note and submit
view -> ctrl--: POST /admin/reports/content/{id}/resolve (ResolveReportRequest)
activate ctrl

ctrl -> ctrl++: getAdminId(authentication)
ctrl--

ctrl -> ctrl++: getClientIp(httpRequest)
ctrl--

ctrl -> svc++: resolveContentReport(adminId, reportId, request, clientIp)

svc -> rpt_repo++: findById(reportId)
rpt_repo -> db++: Execute query
db -->> rpt_repo: Return report
db--
rpt_repo -->> svc: Return contentReport
rpt_repo--

opt Report status != "RECEIVED"
    svc -->> ctrl: Throw IllegalStateException("Báo cáo đã được xử lý trước đó")
    ctrl -->> view: Redirect /admin/reports with errorMessage
    activate view
    view -->> adm: Display error alert banner
    deactivate view
end

alt Decision == "REJECTED"
    svc -> svc++: Set report.status = "REJECTED"
    svc--

    svc -> rpt_repo++: save(report)
    rpt_repo -> db++: Update content_reports SET status = 'REJECTED'
    db -->> rpt_repo: Return saved report
    db--
    rpt_repo -->> svc: Return saved report
    rpt_repo--

    svc -> notif_ett++: Call Notification.builder()
    notif_ett -->> svc--: Return notification entity

    svc -> notif_repo++: save(notification)
    notif_repo -> db++: Insert rejection feedback notification
    db -->> notif_repo: Return saved notification
    db--
    notif_repo -->> svc: Return saved notification
    notif_repo--

    svc -> audit_ett++: Call SystemAuditLog.builder()
    audit_ett -->> svc--: Return auditLog entity

    svc -> audit_repo++: save(auditLog)
    audit_repo -> db++: Insert into system_audit_logs (REJECT_CONTENT_REPORT)
    db -->> audit_repo: Return saved audit log
    db--
    audit_repo -->> svc: Return saved audit log
    audit_repo--

    svc -->> ctrl: Return void
    ctrl -->> view: Redirect /admin/reports with successMessage
    activate view
    view -->> adm: Display rejection success toast
    deactivate view
else Decision == "PROCESSED"
    opt Action == "DRAFT_CHAPTER"
        svc -> ch_repo++: save(chapter)
        ch_repo -> db++: Update chapters SET status = 'DRAFT' WHERE id = chapterId
        db -->> ch_repo: Return updated chapter
        db--
        ch_repo -->> svc: Return updated chapter
        ch_repo--
    end

    svc -> svc++: Set report.status = "PROCESSED"
    svc--

    svc -> rpt_repo++: save(report)
    rpt_repo -> db++: Update content_reports SET status = 'PROCESSED'
    db -->> rpt_repo: Return saved report
    db--
    rpt_repo -->> svc: Return saved report
    rpt_repo--

    svc -> notif_ett++: Call Notification.builder()
    notif_ett -->> svc--: Return notification entity

    svc -> notif_repo++: save(notification)
    notif_repo -> db++: Insert resolution feedback notification
    db -->> notif_repo: Return saved notification
    db--
    notif_repo -->> svc: Return saved notification
    notif_repo--

    svc -> audit_ett++: Call SystemAuditLog.builder()
    audit_ett -->> svc--: Return auditLog entity

    svc -> audit_repo++: save(auditLog)
    audit_repo -> db++: Insert into system_audit_logs (RESOLVE_CONTENT_REPORT)
    db -->> audit_repo: Return saved audit log
    db--
    audit_repo -->> svc: Return saved audit log
    audit_repo--

    svc -->> ctrl--: Return void

    ctrl -->> view--: Redirect /admin/reports with successMessage
    deactivate ctrl
    activate view
    view -->> adm--: Display resolution success toast and update table status
    deactivate view
end

deactivate adm

@enduml
