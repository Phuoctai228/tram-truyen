@startuml sq_uc28_view_reading_history
<style>
    sequenceDiagram{
        FontSize 16

        arrow {
            ' Set the maximum width of the text on arrows
            MaximumWidth 300
        }
        actor{
            BackgroundColor white
            LineThickness 1.0
        }
        participant{
            BackgroundColor white
            RoundCorner 0
        }
        database{
            BackgroundColor white
        }
        groupHeader{
            BackgroundColor white
        }
        referenceHeader{
            BackgroundColor white
        }
        reference{
            BackgroundColor white
        }
    }
</style>

hide footbox
mainframe View Reading History

actor Member as act
participant "ReadingHistoryPage" as view
participant "LoginPage" as r_view
participant "UserController" as ctrl <<controller>>
participant ":ReadingHistoryService" as history_svc
participant ":ReadingHistoryItemDTO" as history_dto
participant ":UserRepository" as user_repo
participant ":UserChapterActivityRepository" as activity_repo
database Database as db

act ++

act -> view++: Access reading history page
view -> ctrl++: GET /user/history?page={page}&size={size}

ctrl -> ctrl++: Check authentication status
ctrl--
alt User is not authenticated
    ctrl -->> r_view: Redirect to /login?redirect=/user/history
    activate r_view
    r_view -->> act: Display login page
    deactivate r_view
else User is authenticated
    ctrl -> history_svc++: getReadingHistory(email, page, size)

    history_svc -> user_repo++: findByEmail(email)
    user_repo -> db++: Execute query
    db -->> user_repo: Return user data
    db--
    user_repo -->> history_svc: Return user entity
    user_repo--

    history_svc -> activity_repo++: findAllByUserAndReadAtIsNotNullOrderByReadAtDesc(user, pageable)
    activity_repo -> db++: Execute query
    db -->> activity_repo: Return paged read activities
    db--
    activity_repo -->> history_svc: Return paged read activities
    activity_repo--

    history_svc -> history_dto++: Call ReadingHistoryItemDTO(activity, chapter, novel)
    history_dto -->> history_svc--: Return readingHistoryItemDTO

    history_svc -->> ctrl--: Return historyPage

    ctrl -->> view--: Return "user/history"
    view -->> act: Display paginated reading history list

    view -> view++: Check if user removes history item
    view--
    opt Remove history item
        act -> view: Click remove item button
        view -> ctrl++: POST /user/history/remove/{chapterId}

        ctrl -> history_svc++: removeHistoryItem(email, chapterId)

        history_svc -> user_repo++: findByEmail(email)
        user_repo -> db++: Execute query
        db -->> user_repo: Return user entity
        db--
        user_repo -->> history_svc: Return user entity
        user_repo--

        history_svc -> activity_repo++: findByUserAndChapterId(user, chapterId)
        activity_repo -> db++: Execute query
        db -->> activity_repo: Return activity entity
        db--
        activity_repo -->> history_svc: Return activity entity
        activity_repo--

        history_svc -> history_svc++: Check if chapter is unlocked VIP
        history_svc--
        alt Chapter is unlocked VIP (preserve VIP ownership)
            history_svc -> history_svc++: Reset isRead = false and readAt = null
            history_svc--
            history_svc -> activity_repo++: save(activity)
            activity_repo -> db++: Save changes to database
            db -->> activity_repo: Return updated activity
            db--
            activity_repo -->> history_svc: Return updated activity
            activity_repo--
        else Free chapter
            history_svc -> activity_repo++: delete(activity)
            activity_repo -> db++: Save changes to database
            db -->> activity_repo: Return result
            db--
            activity_repo -->> history_svc: Return result
            activity_repo--
        end

        history_svc -->> ctrl--: Return result
        ctrl -->> view--: Redirect to /user/history
        view -->> act: Display updated reading history
    end
    deactivate view
end

@enduml
