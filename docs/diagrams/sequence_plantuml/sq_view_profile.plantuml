@startuml sq_view_profile
<style>
    sequenceDiagram{
        FontSize 16

        arrow {
            ' Set the maximum width of the text on arrows
            MaximumWidth 300
        }
        actor{
            BackgroundColor white
            LineThickness 1.0
        }
        participant{
            BackgroundColor white
            RoundCorner 0
        }
        database{
            BackgroundColor white
        }
        groupHeader{
            BackgroundColor white
        }
        referenceHeader{
            BackgroundColor white
        }
        reference{
            BackgroundColor white
        }
    }
</style>

hide footbox
mainframe View Profile

actor Member as act
participant "ProfilePage" as view
participant "LoginPage" as r_view
participant "UserController" as ctrl <<controller>>
participant ":BookshelfService" as svc
participant ":UserProfileDTO" as dto
participant ":UserRepository" as user_repo
participant ":BookshelfRepository" as bookshelf_repo
database Database as db

act ++

act -> view++: Access profile page
view -> ctrl--: GET /user/profile
activate ctrl

ctrl -> ctrl++: Check authentication status
ctrl--
alt User is not authenticated
    ctrl -->> r_view: Redirect to /login?redirect=/user/profile
    activate r_view
    r_view -->> act: Display login page
    deactivate r_view
else User is authenticated
    ctrl -> svc++: getUserProfile(email)

    svc -> user_repo++: findByEmail(email)
    user_repo -> db++: Execute query
    db -->> user_repo: Return user data
    db--
    user_repo -->> svc: Return user entity
    user_repo--

    svc -> dto++: Call UserProfileDTO.builder()
    dto -->> svc--: Return userProfileDTO

    svc -->> ctrl--: Return userProfileDTO

    ctrl -> svc++: getUserBookshelf(email)

    svc -> user_repo++: findByEmail(email)
    user_repo -> db++: Execute query
    db -->> user_repo: Return user data
    db--
    user_repo -->> svc: Return user entity
    user_repo--

    svc -> bookshelf_repo++: findAllByUserWithNovel(user)
    bookshelf_repo -> db++: Execute query
    db -->> bookshelf_repo: Return bookshelf list
    db--
    bookshelf_repo -->> svc: Return bookshelf list
    bookshelf_repo--

    svc -->> ctrl--: Return bookshelf list

    ctrl -->> view--: Return "user/profile"
    activate view
    view -->> act--: Display profile details and Coin balance
end

@enduml
