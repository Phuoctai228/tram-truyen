@startuml sq_view_user_list
<style>
    sequenceDiagram{
        FontSize 16
        LineColor black

        arrow {
            ' Set the maximum width of the text on arrows
            MaximumWidth 300
            LineColor black
        }
        actor{
            BackgroundColor white
            LineColor black
            LineThickness 1.0
        }
        participant{
            BackgroundColor white
            LineColor black
            RoundCorner 0
        }
        database{
            BackgroundColor white
            LineColor black
        }
        lifeLine{
            LineColor black
        }
        group{
            LineColor black
        }
        groupHeader{
            BackgroundColor white
            LineColor black
        }
        referenceHeader{
            BackgroundColor white
            LineColor black
        }
        reference{
            BackgroundColor white
            LineColor black
        }
    }
</style>

hide footbox
mainframe View User List (UC-49)

actor Admin as adm
participant "UserListPage" as view
participant "UserAdminController" as ctrl <<controller>>
participant ":UserManagementService" as svc
participant ":UserRepository" as user_repo
participant ":SystemAuditLogRepository" as audit_repo
database Database as db

adm ++

adm -> view++: Select filter (role, status, keyword) and click "Tìm kiếm"
view -> ctrl--: GET /admin/users?keyword=kw&role=r&status=st&page=0
activate ctrl

ctrl -> svc++: getUsers(keyword, role, status, 0, 7)

svc -> user_repo++: searchUsers(keyword, keywordId, role, status, pageable)
user_repo -> db++: Execute search query with filters
db -->> user_repo: Return user page
db--
user_repo -->> svc: Return user page
user_repo--

opt Page contains banned users (bannedUserIds not empty)
    svc -> audit_repo++: findByTargetEntityAndActionTypeAndTargetIdInOrderByCreatedAtDesc("USERS", "BAN_USER", bannedUserIds)
    audit_repo -> db++: Execute query
    db -->> audit_repo: Return ban audit logs
    db--
    audit_repo -->> svc: Return ban audit logs
    audit_repo--
end

svc -->> ctrl--: Return Page~UserManagementDTO~

ctrl -> svc++: getUserStats()

svc -> user_repo++: count()
user_repo -> db++: Execute query
db -->> user_repo: Return total count
db--
user_repo -->> svc: Return total users
user_repo--

svc -> user_repo++: countByStatus("ACTIVE")
user_repo -> db++: Execute query
db -->> user_repo: Return active count
db--
user_repo -->> svc: Return active count
user_repo--

svc -> user_repo++: countByStatus("BANNED")
user_repo -> db++: Execute query
db -->> user_repo: Return banned count
db--
user_repo -->> svc: Return banned count
user_repo--

svc -->> ctrl--: Return userStatsDTO

ctrl -->> view--: Return "admin/users/list"
deactivate ctrl
activate view
view -->> adm--: Display user management table and statistics cards
deactivate view

deactivate adm

@enduml
