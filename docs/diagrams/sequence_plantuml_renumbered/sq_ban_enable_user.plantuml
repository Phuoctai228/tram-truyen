@startuml sq_ban_enable_user
<style>
    sequenceDiagram{
        FontSize 16
        LineColor black

        arrow {
            ' Set the maximum width of the text on arrows
            MaximumWidth 300
            LineColor black
        }
        actor{
            BackgroundColor white
            LineColor black
            LineThickness 1.0
        }
        participant{
            BackgroundColor white
            LineColor black
            RoundCorner 0
        }
        database{
            BackgroundColor white
            LineColor black
        }
        lifeLine{
            LineColor black
        }
        group{
            LineColor black
        }
        groupHeader{
            BackgroundColor white
            LineColor black
        }
        referenceHeader{
            BackgroundColor white
            LineColor black
        }
        reference{
            BackgroundColor white
            LineColor black
        }
    }
</style>

hide footbox
mainframe Khóa / Mở khóa tài khoản (UC-50)

actor Admin as adm
participant "UserListPage" as view
participant "UserAdminController" as ctrl <<controller>>
participant ":UserManagementService" as svc
participant ":AccountLockService" as lock_svc
participant ":UserRepository" as user_repo
participant ":Notification" as notif_ett
participant ":SystemAuditLog" as audit_ett
participant ":NotificationRepository" as notif_repo
participant ":SystemAuditLogRepository" as audit_repo
database Database as db

adm ++

alt Luồng 1: Admin khóa tài khoản (Ban User)
    adm -> view++:0.1. Select reason, duration, note and click "Xác nhận khóa"
    view -> ctrl--:0.1.1. POST /admin/users/{id}/ban (BanUserRequest)
    activate ctrl

    ctrl -> ctrl++:0.1.2. getAdminId(authentication)
    ctrl--

    ctrl -> ctrl++:0.1.3. getClientIp(httpRequest)
    ctrl--

    ctrl -> svc++:0.1.4. banUser(adminId, request, clientIp)

    svc -> user_repo++:0.1.5. findById(targetUserId)
    user_repo -> db++:0.1.6. Execute query
    db -->> user_repo:0.1.7. Return target user
    db--
    user_repo -->> svc:0.1.8. Return user entity
    user_repo--

    svc -> svc++:0.1.9. Set user.status = "BANNED"
    svc--

    svc -> user_repo++:0.1.10. save(user)
    user_repo -> db++:0.1.11. Update users SET status = 'BANNED'
    db -->> user_repo:0.1.12. Return saved user
    db--
    user_repo -->> svc:0.1.13. Return saved user
    user_repo--

    svc -> audit_ett++:0.1.14. Call SystemAuditLog.builder()
    audit_ett -->> svc--:0.1.15. Return auditLog entity

    svc -> audit_repo++:0.1.16. save(auditLog)
    audit_repo -> db++:0.1.17. Insert into system_audit_logs (actionType = "BAN_USER")
    db -->> audit_repo:0.1.18. Return saved audit log
    db--
    audit_repo -->> svc:0.1.19. Return saved audit log
    audit_repo--

    svc -> notif_ett++:0.1.20. [If sendNotification == true] Call Notification.builder()
    notif_ett -->> svc--:0.1.21. Return notification entity

    svc -> notif_repo++:0.1.22. [If sendNotification == true] save(notification)
    notif_repo -> db++:0.1.23. Insert into notifications
    db -->> notif_repo:0.1.24. Return saved notification
    db--
    notif_repo -->> svc:0.1.25. Return saved notification
    notif_repo--

    svc -->> ctrl--:0.1.26. Return void

    ctrl -->> view--:0.1.27. Redirect /admin/users with successMessage
    activate view
    view -->> adm:0.1.28. Display success toast and update user status to BANNED
    deactivate view

else Luồng 2: Admin mở khóa tài khoản (Unban User)
    adm -> view++:0.2. Enter unban note and click "Mở khóa ngay"
    view -> ctrl--:0.2.1. POST /admin/users/{id}/unban (UnbanUserRequest)
    activate ctrl

    ctrl -> ctrl++:0.2.2. getAdminId(authentication)
    ctrl--

    ctrl -> ctrl++:0.2.3. getClientIp(httpRequest)
    ctrl--

    ctrl -> svc++:0.2.4. unbanUser(adminId, request, clientIp)

    svc -> user_repo++:0.2.5. findById(targetUserId)
    user_repo -> db++:0.2.6. Execute query
    db -->> user_repo:0.2.7. Return target user
    db--
    user_repo -->> svc:0.2.8. Return user entity
    user_repo--

    svc -> svc++:0.2.9. Update user.status = "ACTIVE"
    svc--

    svc -> user_repo++:0.2.10. save(user)
    user_repo -> db++:0.2.11. Update users SET status = 'ACTIVE'
    db -->> user_repo:0.2.12. Return saved user
    db--
    user_repo -->> svc:0.2.13. Return saved user
    user_repo--

    svc -> audit_ett++:0.2.14. Call SystemAuditLog.builder()
    audit_ett -->> svc--:0.2.15. Return auditLog entity

    svc -> audit_repo++:0.2.16. save(auditLog)
    audit_repo -> db++:0.2.17. Insert into system_audit_logs (actionType = "UNBAN_USER")
    db -->> audit_repo:0.2.18. Return saved audit log
    db--
    audit_repo -->> svc:0.2.19. Return saved audit log
    audit_repo--

    svc -> notif_ett++:0.2.20. [If sendNotification == true] Call Notification.builder()
    notif_ett -->> svc--:0.2.21. Return notification entity

    svc -> notif_repo++:0.2.22. [If sendNotification == true] save(notification)
    notif_repo -> db++:0.2.23. Insert into notifications
    db -->> notif_repo:0.2.24. Return saved notification
    db--
    notif_repo -->> svc:0.2.25. Return saved notification
    notif_repo--

    svc -->> ctrl--:0.2.26. Return void

    ctrl -->> view--:0.2.27. Redirect /admin/users with successMessage
    activate view
    view -->> adm:0.2.28. Display success toast and update user status to ACTIVE
    deactivate view
end

deactivate adm

group Luồng 3: Tác vụ mở khóa tự động (AUTO_UNBAN)
    [o-> lock_svc++:1. checkAndAutoUnban(user)

    lock_svc -> audit_repo++:2. findFirstByTargetEntityAndTargetIdAndActionTypeOrderByCreatedAtDesc("USERS", user.getId(), "BAN_USER")
    audit_repo -> db++:3. SELECT * FROM system_audit_logs WHERE target_entity = 'USERS' AND target_id = ? AND action_type = 'BAN_USER' ORDER BY created_at DESC
    db -->> audit_repo:4. Return banLog
    db--
    audit_repo -->> lock_svc:5. Return Optional<SystemAuditLog>
    audit_repo--

    lock_svc -> lock_svc++:6. [If ban expired] user.setStatus("ACTIVE")
    lock_svc--

    lock_svc -> user_repo++:7. [If ban expired] save(user)
    user_repo -> db++:8. Update user status to ACTIVE
    db -->> user_repo:9. Return saved user
    db--
    user_repo -->> lock_svc:10. Return saved user
    user_repo--

    lock_svc -> audit_ett++:11. [If ban expired] Call SystemAuditLog.builder()
    audit_ett -->> lock_svc--:12. Return auditLog entity

    lock_svc -> audit_repo++:13. [If ban expired] save(auditLog)
    audit_repo -> db++:14. Insert into system_audit_logs (actionType = "AUTO_UNBAN", performer = system.scheduler@internal)
    db -->> audit_repo:15. Return saved audit log
    db--
    audit_repo -->> lock_svc:16. Return saved audit log
    audit_repo--

    [<-- lock_svc--:17. Return isUnbanned (boolean)
end

@enduml
