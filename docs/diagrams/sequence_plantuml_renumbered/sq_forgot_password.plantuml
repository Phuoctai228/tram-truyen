@startuml sq_forgot_password
<style>
    sequenceDiagram{
        FontSize 16

        arrow {
            ' Set the maximum width of the text on arrows
            MaximumWidth 300
        }
        actor{
            BackgroundColor white
            LineThickness 1.0
        }
        participant{
            BackgroundColor white
            RoundCorner 0
        }
        database{
            BackgroundColor white
        }
        groupHeader{
            BackgroundColor white
        }
        referenceHeader{
            BackgroundColor white
        }
        reference{
            BackgroundColor white
        }
    }
</style>

hide footbox
mainframe Forgot Password

actor Guest as act
participant "ForgotPasswordPage" as view
participant "ForgotVerifyOtpPage" as verify_view
participant "ResetPasswordPage" as reset_view
participant "LoginPage" as login_view
participant "AuthController" as ctrl <<controller>>
participant ":AuthService" as svc
participant ":PasswordEncoder" as encoder
participant ":EmailService" as email_svc
participant ":EmailVerificationToken" as token
participant ":UserRepository" as user_repo
participant ":EmailVerificationTokenRepository" as token_repo
database Database as db

act ++

act -> view++:1. Submit forgot password request
view -> ctrl++:2. POST /forgot-password

ctrl -> svc++:3. sendForgotPasswordOtp(email)

svc -> user_repo++:4. findByEmail(email)
user_repo -> db++:5. Execute query
db -->> user_repo:6. Return user data
db--
user_repo -->> svc:7. Return user entity
user_repo--

svc -> svc++:8. Validate user account and status
svc--
alt Email not found or account banned
    svc -->> ctrl:8.1. throw IllegalArgumentException
    ctrl -->> view:8.1.1. Return "authentication/forgot-password"
    view -->> act:8.1.2. Display error message
    deactivate view
else Valid local account
    svc -> token_repo++:8.2. deleteByUser(user)
    token_repo -> db++:8.2.1. Save changes to database
    db -->> token_repo:8.2.2. Return result
    db--
    token_repo -->> svc:8.2.3. Return result
    token_repo--

    svc -> svc++:8.2.4. Generate 6-digit OTP code
    svc--

    svc -> token++:8.2.5. Call EmailVerificationToken(user, otp)
    token -->> svc--:8.2.6. Return token entity

    svc -> token_repo++:8.2.7. save(token)
    token_repo -> db++:8.2.8. Save changes to database
    db -->> token_repo:8.2.9. Return saved token
    db--
    token_repo -->> svc:8.2.10. Return saved token
    token_repo--

    svc -> email_svc++:8.2.11. sendForgotPasswordOtpEmail(email, otp)
    email_svc -->> svc--:8.2.12. Return result

    svc -->> ctrl--:8.2.13. Return result
    ctrl -->> verify_view--:8.2.14. Redirect to /forgot-password/verify-otp
    activate verify_view
    verify_view -->> act:8.2.15. Display OTP verification page
end

act -> verify_view:9. Submit OTP code
verify_view -> ctrl++:10. POST /forgot-password/verify-otp

ctrl -> svc++:11. verifyForgotPasswordOtp(email, otpCode)

svc -> user_repo++:12. findByEmail(email)
user_repo -> db++:13. Execute query
db -->> user_repo:14. Return user data
db--
user_repo -->> svc:15. Return user entity
user_repo--

svc -> token_repo++:16. findByOtpCodeAndUser(otpCode, user)
token_repo -> db++:17. Execute query
db -->> token_repo:18. Return token data
db--
token_repo -->> svc:19. Return token entity
token_repo--

svc -> svc++:20. Validate OTP correctness and expiration
svc--
alt Invalid or expired OTP
    svc -->> ctrl:20.1. throw IllegalArgumentException
    ctrl -->> verify_view:20.1.1. Return "authentication/forgot-password-verify-otp"
    verify_view -->> act:20.1.2. Display OTP error message
    deactivate verify_view
else Valid OTP
    svc -->> ctrl--:20.2. Return result
    ctrl -> ctrl++:20.2.1. Save email to session
    ctrl--
    ctrl -->> reset_view--:20.2.2. Redirect to /forgot-password/reset
    activate reset_view
    reset_view -->> act:20.2.3. Display reset password form
end

act -> reset_view:21. Submit new password
reset_view -> ctrl++:22. POST /forgot-password/reset

ctrl -> ctrl++:23. Validate passwords match
ctrl--
opt Passwords do not match
    ctrl -->> reset_view:23.1. Return "authentication/reset-password"
    reset_view -->> act:23.1.1. Display password mismatch error message
end

ctrl -> svc++:24. resetPassword(email, newPassword)

svc -> svc++:25. Validate password strength
svc--
alt Weak password
    svc -->> ctrl:25.1. throw IllegalArgumentException
    ctrl -->> reset_view:25.1.1. Return "authentication/reset-password"
    reset_view -->> act:25.1.2. Display error message
    deactivate reset_view
else Valid new password
    svc -> user_repo++:25.2. findByEmail(email)
    user_repo -> db++:25.2.1. Execute query
    db -->> user_repo:25.2.2. Return user data
    db--
    user_repo -->> svc:25.2.3. Return user data
    user_repo--

    svc -> encoder++:25.2.4. encode(newPassword)
    encoder -->> svc--:25.2.5. Return encodedPassword

    svc -> user_repo++:25.2.6. save(user)
    user_repo -> db++:25.2.7. Save changes to database
    db -->> user_repo:25.2.8. Return saved user
    db--
    user_repo -->> svc:25.2.9. Return saved user
    user_repo--

    svc -> token_repo++:25.2.10. deleteByUser(user)
    token_repo -> db++:25.2.11. Save changes to database
    db -->> token_repo:25.2.12. Return result
    db--
    token_repo -->> svc:25.2.13. Return result
    token_repo--

    svc -->> ctrl--:25.2.14. Return result
    ctrl -->> login_view--:25.2.15. Redirect to /login
    activate login_view
    login_view -->> act--:25.2.16. Display login page with success message
end

@enduml
