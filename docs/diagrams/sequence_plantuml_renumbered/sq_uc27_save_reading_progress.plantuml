@startuml sq_uc27_save_reading_progress
<style>
    sequenceDiagram{
        FontSize 16

        arrow {
            ' Set the maximum width of the text on arrows
            MaximumWidth 300
        }
        actor{
            BackgroundColor white
            LineThickness 1.0
        }
        participant{
            BackgroundColor white
            RoundCorner 0
        }
        database{
            BackgroundColor white
        }
        groupHeader{
            BackgroundColor white
        }
        referenceHeader{
            BackgroundColor white
        }
        reference{
            BackgroundColor white
        }
    }
</style>

hide footbox
mainframe Save Reading Progress

actor Member as act
participant "ChapterReaderPage" as view
participant "BookshelfController" as ctrl <<controller>>
participant ":BookshelfService" as svc
participant ":UserChapterActivity" as ett
participant ":UserRepository" as user_repo
participant ":ChapterRepository" as chapter_repo
participant ":UserChapterActivityRepository" as activity_repo
database Database as db

act ++

act -> view++: 1. Scroll chapter content (>= 95% threshold) or short chapter fully displayed
view -> view++: 2. Save scroll percentage and latest chapter to localStorage
view--

view -> ctrl++: 3. POST /api/user/reading/complete-chapter

ctrl -> ctrl++: 4. Validate authentication and chapterId payload
ctrl--
alt User is not authenticated
    ctrl -->> view: 5. Return ResponseEntity.status(401)
    view -->> act: 6. Keep local progress in localStorage only
else Missing chapterId in payload
    ctrl -->> view: 7. Return ResponseEntity.badRequest()
    view -->> act: 8. Ignore invalid progress request
else Authenticated with valid chapterId
    ctrl -> svc++: 9. recordChapterRead(email, chapterId)

    svc -> user_repo++: 10. findByEmail(email)
    user_repo -> db++: 11. Execute query
    db -->> user_repo: 12. Return user data
    db--
    user_repo -->> svc: 13. Return user entity
    user_repo--

    svc -> chapter_repo++: 14. findById(chapterId)
    chapter_repo -> db++: 15. Execute query
    db -->> chapter_repo: 16. Return chapter data
    db--
    chapter_repo -->> svc: 17. Return chapter entity
    chapter_repo--

    svc -> activity_repo++: 18. findByUserAndChapter(user, chapter)
    activity_repo -> db++: 19. Execute query
    db -->> activity_repo: 20. Return activity data
    db--
    activity_repo -->> svc: 21. Return activity entity
    activity_repo--

    svc -> svc++: 22. Check if UserChapterActivity record exists
    svc--
    alt Activity record already exists
        svc -> svc++: 23. Update isRead = true and readAt = now
        svc--
    else Activity record does not exist
        svc -> ett++: 24. Call UserChapterActivity(user, chapter, true, now)
        ett -->> svc--: 25. Return activity entity
    end

    svc -> activity_repo++: 26. save(activity)
    activity_repo -> db++: 27. Save changes to database
    db -->> activity_repo: 28. Return saved activity
    db--
    activity_repo -->> svc: 29. Return saved activity
    activity_repo--

    svc -->> ctrl--: 30. Return result
    ctrl -->> view--: 31. Return ResponseEntity.ok()
    view -->> act--: 32. Update reading progress indicator
end

@enduml

