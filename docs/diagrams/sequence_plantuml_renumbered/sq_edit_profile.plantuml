@startuml sq_edit_profile
<style>
    sequenceDiagram{
        FontSize 16

        arrow {
            ' Set the maximum width of the text on arrows
            MaximumWidth 300
        }
        actor{
            BackgroundColor white
            LineThickness 1.0
        }
        participant{
            BackgroundColor white
            RoundCorner 0
        }
        database{
            BackgroundColor white
        }
        groupHeader{
            BackgroundColor white
        }
        referenceHeader{
            BackgroundColor white
        }
        reference{
            BackgroundColor white
        }
    }
</style>

hide footbox
mainframe Edit Profile

actor Member as act
participant "EditProfilePage" as view
participant "ProfilePage" as r_view
participant "LoginPage" as login_view
participant "UserController" as ctrl <<controller>>
participant ":UserService" as svc
participant ":MediaStorageService" as media_svc
participant "Cloudinary" as cloud
participant ":UserRepository" as user_repo
database Database as db

act ++

act -> view++:1. Submit edit profile form
view -> ctrl++:2. POST /user/edit-profile

ctrl -> ctrl++:3. Check authentication status
ctrl--
opt User is not authenticated
    ctrl -->> login_view:3.1. Redirect to /login?redirect=/user/edit-profile
    activate login_view
    login_view -->> act:3.1.1. Display login page
    deactivate login_view
end

ctrl -> svc++:4. updateProfile(email, fullName, avatar)

svc -> user_repo++:5. findByEmail(email)
user_repo -> db++:6. Execute query
db -->> user_repo:7. Return user data
db--
user_repo -->> svc:8. Return user entity
user_repo--

svc -> svc++:9. Check if new avatar provided
svc--
opt Avatar file is present
    svc -> media_svc++:9.2. uploadImage(avatar)
    media_svc -> cloud++:9.2.1. Upload image file
    cloud -->> media_svc:9.2.2. Return secure_url
    cloud--
    media_svc -->> svc:9.2.3. Return avatarUrl
    media_svc--
end

svc -> svc++:10. Validate profile data
svc--
alt Invalid input or upload failure
    svc -->> ctrl:10.1. throw Exception
    ctrl -->> view:10.1.1. Redirect to /user/edit-profile
    view -->> act:10.1.2. Display error message
    deactivate view
else Valid profile data
    svc -> user_repo++:10.2. save(user)
    user_repo -> db++:10.2.1. Save changes to database
    db -->> user_repo:10.2.2. Return saved user
    db--
    user_repo -->> svc:10.2.3. Return saved user
    user_repo--

    svc -->> ctrl--:10.2.4. Return result
    ctrl -->> r_view--:10.2.5. Redirect to /user/profile
    activate r_view
    r_view -->> act--:10.2.6. Display profile with success message
end

@enduml
