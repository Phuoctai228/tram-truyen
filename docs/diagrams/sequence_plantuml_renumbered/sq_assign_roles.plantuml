@startuml sq_assign_roles
<style>
    sequenceDiagram{
        FontSize 16
        LineColor black

        arrow {
            ' Set the maximum width of the text on arrows
            MaximumWidth 300
            LineColor black
        }
        actor{
            BackgroundColor white
            LineColor black
            LineThickness 1.0
        }
        participant{
            BackgroundColor white
            LineColor black
            RoundCorner 0
        }
        database{
            BackgroundColor white
            LineColor black
        }
        lifeLine{
            LineColor black
        }
        group{
            LineColor black
        }
        groupHeader{
            BackgroundColor white
            LineColor black
        }
        referenceHeader{
            BackgroundColor white
            LineColor black
        }
        reference{
            BackgroundColor white
            LineColor black
        }
    }
</style>

hide footbox
mainframe Assign Roles (UC-48)

actor Admin as adm
participant "UserListPage" as view
participant "UserAdminController" as ctrl <<controller>>
participant ":UserManagementService" as svc
participant ":UserRepository" as user_repo
participant ":RoleRepository" as role_repo
participant ":SystemAuditLog" as audit_ett
participant ":Notification" as notif_ett
participant ":SystemAuditLogRepository" as audit_repo
participant ":NotificationRepository" as notif_repo
database Database as db

adm ++

adm -> view++:1. Select user, check/uncheck Staff role and click "Xác nhận phân quyền"
view -> ctrl--:2. POST /admin/users/assign-role (AssignRoleRequest)
activate ctrl

ctrl -> ctrl++:3. getAdminId(authentication)
ctrl--

ctrl -> ctrl++:4. getClientIp(httpRequest)
ctrl--

ctrl -> svc++:5. assignRole(adminId, request, clientIp)

svc -> user_repo++:6. findById(userId)
user_repo -> db++:7. Execute query
db -->> user_repo:8. Return user data
db--
user_repo -->> svc:9. Return user entity
user_repo--

alt Target not active, is Admin, is Self, or Role unchanged
    svc -->> ctrl:9.1. Throw IllegalStateException / IllegalArgumentException
    ctrl -->> view:9.1.1. Redirect /admin/users with errorMessage
    activate view
    view -->> adm:9.1.2. Display role assignment error banner
    deactivate view
else Valid role change
alt Grant Staff Role (hasStaffRole == true)
        svc -> role_repo++:9.2.1. findByName("ROLE_STAFF")
        role_repo -> db++:9.2.1.1. Execute query
        db -->> role_repo:9.2.1.2. Return staff role
        db--
        role_repo -->> svc:9.2.1.3. Return staff role
        role_repo--
        svc -> svc++:9.2.1.4. Add ROLE_STAFF to user.roles
        svc--
else Revoke Staff Role (hasStaffRole == false)
        svc -> svc++:9.2.2. Remove ROLE_STAFF from user.roles
        svc--
end

    svc -> user_repo++:9.3. save(user)
    user_repo -> db++:9.4. Update user_roles mapping table
    db -->> user_repo:9.5. Return saved user
    db--
    user_repo -->> svc:9.6. Return saved user
    user_repo--

    svc -> audit_ett++:9.7. Call SystemAuditLog.builder()
    audit_ett -->> svc--:9.8. Return auditLog entity

    svc -> audit_repo++:9.9. save(auditLog)
    audit_repo -> db++:9.10. Insert into system_audit_logs (actionType = "CHANGE_USER_ROLE")
    db -->> audit_repo:9.11. Return saved audit log
    db--
    audit_repo -->> svc:9.12. Return saved audit log
    audit_repo--

    svc -> notif_ett++:9.13. Call Notification.builder()
    notif_ett -->> svc--:9.14. Return notification entity

    svc -> notif_repo++:9.15. save(notification)
    notif_repo -> db++:9.16. Insert into notifications
    db -->> notif_repo:9.17. Return saved notification
    db--
    notif_repo -->> svc:9.18. Return saved notification
    notif_repo--

    svc -->> ctrl--:9.19. Return void

    ctrl -->> view--:9.20. Redirect /admin/users with successMessage
    deactivate ctrl
    activate view
    view -->> adm--:9.21. Display success toast and update user role badge in table
    deactivate view
end

deactivate adm

@enduml
