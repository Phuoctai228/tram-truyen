@startuml sq_login_with_google
<style>
    sequenceDiagram{
        FontSize 16

        arrow {
            ' Set the maximum width of the text on arrows
            MaximumWidth 300
        }
        actor{
            BackgroundColor white
            LineThickness 1.0
        }
        participant{
            BackgroundColor white
            RoundCorner 0
        }
        database{
            BackgroundColor white
        }
        groupHeader{
            BackgroundColor white
        }
        referenceHeader{
            BackgroundColor white
        }
        reference{
            BackgroundColor white
        }
    }
</style>

hide footbox
mainframe Login with Google

actor Guest as act
participant "LoginPage" as view
participant "HomePage" as r_view
participant "AccountLockedPage" as locked_view
participant "Google OAuth2 Server" as google
participant "SecurityFilterChain" as sec
participant ":CustomOAuth2UserService" as oauth_svc
participant ":AccountLockService" as lock_svc
participant ":CustomAuthenticationSuccessHandler" as success_handler
participant ":CustomAuthenticationFailureHandler" as failure_handler
participant ":CustomUserDetails" as details
participant ":AccountLockedInfoDTO" as locked_dto
participant ":User" as ett
participant ":UserRepository" as user_repo
participant ":RoleRepository" as role_repo
participant ":SystemAuditLogRepository" as audit_repo
database Database as db

act ++

act -> view++:1. Click "Login with Google"
view -> sec++:2. GET /oauth2/authorization/google
view--

sec -->> google++:3. Redirect to Google authorization endpoint
google -->> act:4. Display Google consent screen

google -> google++:5. Validate authorization decision
google--
opt Authorization denied by user
    act -> google:5.1. Deny authorization
    google -->> sec:5.1.1. Callback /login/oauth2/code/google (error=access_denied)
    sec -> failure_handler++:5.1.2. onAuthenticationFailure(request, response, exception)
    failure_handler -->> sec--:5.1.3. Return result
    sec -->> view:5.1.4. Redirect to /login?error
    activate view
    view -->> act:5.1.5. Display login cancelled message
    deactivate view
end

act -> google:6. Authorize application
google -->> sec:7. Callback /login/oauth2/code/google (authCode)
google--

sec -> google++:8. Request user info (accessToken)
google -->> sec--:9. Return user profile (email, name, picture)

sec -> oauth_svc++:10. loadUser(userRequest)

oauth_svc -> user_repo++:11. findByEmail(email)
user_repo -> db++:12. Execute query
db -->> user_repo:13. Return user data
db--
user_repo -->> oauth_svc:14. Return user data
user_repo--

oauth_svc -> oauth_svc++:15. Check user existence and account status
oauth_svc--
alt Account banned
    oauth_svc -->> sec:15.1. throw OAuth2AuthenticationException("account_locked")
    sec -> failure_handler++:15.1.1. onAuthenticationFailure(request, response, exception)
    failure_handler -> lock_svc++:15.1.2. buildAccountLockedInfo(email)

    lock_svc -> audit_repo++:15.1.3. findFirstByTargetEntityAndTargetIdAndActionTypeOrderByCreatedAtDesc("USERS", id, "BAN_USER")
    audit_repo -> db++:15.1.4. Execute query
    db -->> audit_repo:15.1.5. Return ban audit log
    db--
    audit_repo -->> lock_svc:15.1.6. Return ban audit log
    audit_repo--

    lock_svc -> locked_dto++:15.1.7. Call AccountLockedInfoDTO(...)
    locked_dto -->> lock_svc--:15.1.8. Return lockedInfo

    lock_svc -->> failure_handler--:15.1.9. Return lockedInfo
    failure_handler -->> sec--:15.1.10. Return result

    sec -->> locked_view:15.1.11. Redirect to /account-locked
    activate locked_view
    locked_view -->> act:15.1.12. Display account locked page
    deactivate locked_view
else Account already exists (active)
    oauth_svc -> user_repo++:15.2. save(user)
    user_repo -> db++:15.2.1. Save changes to database
    db -->> user_repo:15.2.2. Return saved user
    db--
    user_repo -->> oauth_svc:15.2.3. Return saved user
    user_repo--

    oauth_svc -> details++:15.2.4. Call CustomUserDetails(user, attributes)
    details -->> oauth_svc--:15.2.5. Return userDetails

    oauth_svc -->> sec:15.2.6. Return userDetails

    sec -> success_handler++:15.2.7. onAuthenticationSuccess(request, response, authentication)
    success_handler -->> sec--:15.2.8. Return result

    sec -->> r_view:15.2.9. Redirect to /
    activate r_view
    r_view -->> act:15.2.10. Display home page
    deactivate r_view
else New user registration
    oauth_svc -> ett++:15.3. Call User(email, name, picture, "GOOGLE", "ACTIVE")
    ett -->> oauth_svc--:15.3.1. Return user entity

    oauth_svc -> role_repo++:15.3.2. findByName("ROLE_MEMBER")
    role_repo -> db++:15.3.3. Execute query
    db -->> role_repo:15.3.4. Return Role entity
    db--
    role_repo -->> oauth_svc:15.3.5. Return Role entity
    role_repo--

    oauth_svc -> user_repo++:15.3.6. save(user)
    user_repo -> db++:15.3.7. Save changes to database
    db -->> user_repo:15.3.8. Return saved user
    db--
    user_repo -->> oauth_svc:15.3.9. Return saved user
    user_repo--

    oauth_svc -> details++:15.3.10. Call CustomUserDetails(user, attributes)
    details -->> oauth_svc--:15.3.11. Return userDetails

    oauth_svc -->> sec--:15.3.12. Return userDetails

    sec -> success_handler++:15.3.13. onAuthenticationSuccess(request, response, authentication)
    success_handler -->> sec--:15.3.14. Return result

    sec -->> r_view--:15.3.15. Redirect to /
    activate r_view
    r_view -->> act--:15.3.16. Display home page
end

@enduml
