@startuml sq_uc19_remove_novel_from_bookshelf
<style>
    sequenceDiagram{
        FontSize 16

        arrow {
            ' Set the maximum width of the text on arrows
            MaximumWidth 300
        }
        actor{
            BackgroundColor white
            LineThickness 1.0
        }
        participant{
            BackgroundColor white
            RoundCorner 0
        }
        database{
            BackgroundColor white
        }
        groupHeader{
            BackgroundColor white
        }
        referenceHeader{
            BackgroundColor white
        }
        reference{
            BackgroundColor white
        }
    }
</style>

hide footbox
mainframe Remove Novel from Bookshelf

actor Member as act
participant "BookshelfPage" as view
participant "LoginPage" as r_view
participant "BookshelfController" as ctrl <<controller>>
participant ":BookshelfService" as svc
participant ":UserRepository" as user_repo
participant ":NovelRepository" as novel_repo
participant ":BookshelfRepository" as bookshelf_repo
database Database as db

act ++

act -> view++: 1. Confirm removing novel from bookshelf
view -> ctrl++: 2. POST /user/bookshelf/{novelId}/remove

ctrl -> ctrl++: 3. Check authentication status
ctrl--
opt User is not authenticated
    ctrl -->> r_view: 4. Redirect to /login
    activate r_view
    r_view -->> act: 5. Display login page
    deactivate r_view
end

ctrl -> svc++: 6. removeNovelFromBookshelf(email, novelId)

svc -> user_repo++: 7. findByEmail(email)
user_repo -> db++: 8. Execute query
db -->> user_repo: 9. Return user data
db--
user_repo -->> svc: 10. Return user entity
user_repo--

svc -> novel_repo++: 11. findByIdAndIsDeletedFalse(novelId)
novel_repo -> db++: 12. Execute query
db -->> novel_repo: 13. Return novel data
db--
novel_repo -->> svc: 14. Return novel entity
novel_repo--

svc -> bookshelf_repo++: 15. findByUserAndNovel(user, novel)
bookshelf_repo -> db++: 16. Execute query
db -->> bookshelf_repo: 17. Return bookshelf data
db--
bookshelf_repo -->> svc: 18. Return bookshelf entity
bookshelf_repo--

svc -> svc++: 19. Validate bookshelf entry existence
svc--
alt Bookshelf entry not found
    svc -->> ctrl: 20. throw ResourceNotFoundException
    ctrl -->> view: 21. Redirect to /user/bookshelf
    view -->> act: 22. Display error message
else Bookshelf entry found
    svc -> bookshelf_repo++: 23. delete(bookshelf)
    bookshelf_repo -> db++: 24. Save changes to database
    db -->> bookshelf_repo: 25. Return result
    db--
    bookshelf_repo -->> svc: 26. Return result
    bookshelf_repo--

    svc -->> ctrl--: 27. Return result
    ctrl -->> view--: 28. Redirect to /user/bookshelf
    view -->> act--: 29. Display updated bookshelf with success message
end

@enduml

