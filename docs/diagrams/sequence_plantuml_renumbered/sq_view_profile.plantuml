@startuml sq_view_profile
<style>
    sequenceDiagram{
        FontSize 16

        arrow {
            ' Set the maximum width of the text on arrows
            MaximumWidth 300
        }
        actor{
            BackgroundColor white
            LineThickness 1.0
        }
        participant{
            BackgroundColor white
            RoundCorner 0
        }
        database{
            BackgroundColor white
        }
        groupHeader{
            BackgroundColor white
        }
        referenceHeader{
            BackgroundColor white
        }
        reference{
            BackgroundColor white
        }
    }
</style>

hide footbox
mainframe View Profile

actor Member as act
participant "ProfilePage" as view
participant "LoginPage" as r_view
participant "UserController" as ctrl <<controller>>
participant ":BookshelfService" as svc
participant ":UserProfileDTO" as dto
participant ":UserRepository" as user_repo
participant ":BookshelfRepository" as bookshelf_repo
database Database as db

act ++

act -> view++:1. Access profile page
view -> ctrl--:2. GET /user/profile
activate ctrl

ctrl -> ctrl++:3. Check authentication status
ctrl--
alt User is not authenticated
    ctrl -->> r_view:3.1. Redirect to /login?redirect=/user/profile
    activate r_view
    r_view -->> act:3.1.1. Display login page
    deactivate r_view
else User is authenticated
    ctrl -> svc++:3.2. getUserProfile(email)

    svc -> user_repo++:3.2.1. findByEmail(email)
    user_repo -> db++:3.2.2. Execute query
    db -->> user_repo:3.2.3. Return user data
    db--
    user_repo -->> svc:3.2.4. Return user entity
    user_repo--

    svc -> dto++:3.2.5. Call UserProfileDTO.builder()
    dto -->> svc--:3.2.6. Return userProfileDTO

    svc -->> ctrl--:3.2.7. Return userProfileDTO

    ctrl -> svc++:3.2.8. getUserBookshelf(email)

    svc -> user_repo++:3.2.9. findByEmail(email)
    user_repo -> db++:3.2.10. Execute query
    db -->> user_repo:3.2.11. Return user data
    db--
    user_repo -->> svc:3.2.12. Return user entity
    user_repo--

    svc -> bookshelf_repo++:3.2.13. findAllByUserWithNovel(user)
    bookshelf_repo -> db++:3.2.14. Execute query
    db -->> bookshelf_repo:3.2.15. Return bookshelf list
    db--
    bookshelf_repo -->> svc:3.2.16. Return bookshelf list
    bookshelf_repo--

    svc -->> ctrl--:3.2.17. Return bookshelf list

    ctrl -->> view--:3.2.18. Return "user/profile"
    activate view
    view -->> act--:3.2.19. Display profile details and Coin balance
end

@enduml
