@startuml sq_send_notification
<style>
    sequenceDiagram{
        FontSize 16
        LineColor black

        arrow {
            ' Set the maximum width of the text on arrows
            MaximumWidth 300
            LineColor black
        }
        actor{
            BackgroundColor white
            LineColor black
            LineThickness 1.0
        }
        participant{
            BackgroundColor white
            LineColor black
            RoundCorner 0
        }
        database{
            BackgroundColor white
            LineColor black
        }
        lifeLine{
            LineColor black
        }
        group{
            LineColor black
        }
        groupHeader{
            BackgroundColor white
            LineColor black
        }
        referenceHeader{
            BackgroundColor white
            LineColor black
        }
        reference{
            BackgroundColor white
            LineColor black
        }
    }
</style>

hide footbox
mainframe Send Notification (UC-44)

actor Admin as adm
participant "SendNotificationPage" as view
participant "NotificationAdminController" as ctrl <<controller>>
participant ":NotificationService" as svc
participant ":Notification" as notif_ett
participant ":SystemAuditLog" as audit_ett
participant ":UserRepository" as user_repo
participant ":NotificationRepository" as notif_repo
participant ":SystemAuditLogRepository" as audit_repo
database Database as db

adm ++

opt Scope is "SPECIFIC" and admin searches recipient
    adm -> view++:0.1. Type keyword in search box
    view -> ctrl--:0.1.1. GET /admin/notifications/search-users?q=keyword
    activate ctrl

    ctrl -> svc++:0.1.2. searchRecipients(keyword)
    svc -> user_repo++:0.1.3. findTop10ByFullNameContainingIgnoreCaseOrEmailContainingIgnoreCase(keyword, keyword)
    user_repo -> db++:0.1.4. Execute search query
    db -->> user_repo:0.1.5. Return user matches
    db--
    user_repo -->> svc:0.1.6. Return user list
    user_repo--
    svc -->> ctrl--:0.1.7. Return List~UserRecipientDTO~

    ctrl -->> view--:0.1.8. Return 200 OK (List~UserRecipientDTO~)
    activate view
    view -->> adm:0.1.9. Display auto-complete suggestion list
    deactivate view
end

adm -> view++:1. Fill notification form and click "Gửi thông báo"
view -> ctrl--:2. POST /admin/notifications/send (SendNotificationRequest)
activate ctrl

opt Validation error (empty title or content)
    ctrl -->> view:2.2. Redirect /admin/notifications with errorMessage
    activate view
    view -->> adm:2.2.1. Display validation error alert
    deactivate view
end

ctrl -> ctrl++:3. getAdminId(authentication)
ctrl--

ctrl -> ctrl++:4. getClientIp(httpRequest)
ctrl--

ctrl -> svc++:5. sendNotification(adminId, request, clientIp)

alt Scope == "SPECIFIC"
    svc -> user_repo++:5.1. findById(recipientId)
    user_repo -> db++:5.1.1. Execute query
    db -->> user_repo:5.1.2. Return user data
    db--
    user_repo -->> svc:5.1.3. Return recipient entity
    user_repo--
else Scope == "ALL"
    svc -> svc++:5.2. Set recipientUserId = null (broadcast)
    svc--
end

svc -> notif_ett++:6. Call Notification.builder()
notif_ett -->> svc--:7. Return notification entity

svc -> notif_repo++:8. save(notification)
notif_repo -> db++:9. Insert into notifications
db -->> notif_repo:10. Return saved notification
db--
notif_repo -->> svc:11. Return saved notification
notif_repo--

svc -> audit_ett++:12. Call SystemAuditLog.builder()
audit_ett -->> svc--:13. Return auditLog entity

svc -> audit_repo++:14. save(auditLog)
audit_repo -> db++:15. Insert into system_audit_logs
db -->> audit_repo:16. Return saved audit log
db--
audit_repo -->> svc:17. Return saved audit log
audit_repo--

svc -->> ctrl--:18. Return void

ctrl -->> view--:19. Redirect /admin/notifications with successMessage
deactivate ctrl
activate view
view -->> adm--:20. Display success toast and update recent history
deactivate view

deactivate adm

@enduml
