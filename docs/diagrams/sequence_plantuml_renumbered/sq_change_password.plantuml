@startuml sq_change_password
<style>
    sequenceDiagram{
        FontSize 16

        arrow {
            ' Set the maximum width of the text on arrows
            MaximumWidth 300
        }
        actor{
            BackgroundColor white
            LineThickness 1.0
        }
        participant{
            BackgroundColor white
            RoundCorner 0
        }
        database{
            BackgroundColor white
        }
        groupHeader{
            BackgroundColor white
        }
        referenceHeader{
            BackgroundColor white
        }
        reference{
            BackgroundColor white
        }
    }
</style>

hide footbox
mainframe Change Password

actor Member as act
participant "ChangePasswordPage" as view
participant "ProfilePage" as r_view
participant "LoginPage" as login_view
participant "UserController" as ctrl <<controller>>
participant ":UserService" as svc
participant ":PasswordEncoder" as encoder
participant ":UserRepository" as user_repo
database Database as db

act ++

act -> view++:1. Submit change password form
view -> ctrl++:2. POST /user/change-password

ctrl -> ctrl++:3. Check authentication status
ctrl--
opt User is not authenticated
    ctrl -->> login_view:3.1. Redirect to /login?redirect=/user/change-password
    activate login_view
    login_view -->> act:3.1.1. Display login page
    deactivate login_view
end

ctrl -> svc++:4. changePassword(email, oldPassword, newPassword)

svc -> user_repo++:5. findByEmail(email)
user_repo -> db++:6. Execute query
db -->> user_repo:7. Return user data
db--
user_repo -->> svc:8. Return user entity
user_repo--

svc -> encoder++:9. matches(oldPassword, encodedPassword)
encoder -->> svc--:10. Return isMatched

svc -> svc++:11. Validate current password match
svc--
alt Incorrect current password
    svc -->> ctrl:11.1. throw IllegalArgumentException
    ctrl -->> view:11.1.1. Redirect to /user/change-password
    view -->> act:11.1.2. Display error message
    deactivate view
else Valid current password
    svc -> encoder++:11.2. encode(newPassword)
    encoder -->> svc--:11.2.1. Return encodedPassword

    svc -> user_repo++:11.2.2. save(user)
    user_repo -> db++:11.2.3. Save changes to database
    db -->> user_repo:11.2.4. Return saved user
    db--
    user_repo -->> svc:11.2.5. Return saved user
    user_repo--

    svc -->> ctrl--:11.2.6. Return result
    ctrl -->> r_view--:11.2.7. Redirect to /user/profile
    activate r_view
    r_view -->> act--:11.2.8. Display profile with success message
end

@enduml
