@startuml sq_register_account
<style>
    sequenceDiagram{
        FontSize 16

        arrow {
            ' Set the maximum width of the text on arrows
            MaximumWidth 300
        }
        actor{
            BackgroundColor white
            LineThickness 1.0
        }
        participant{
            BackgroundColor white
            RoundCorner 0
        }
        database{
            BackgroundColor white
        }
        groupHeader{
            BackgroundColor white
        }
        referenceHeader{
            BackgroundColor white
        }
        reference{
            BackgroundColor white
        }
    }
</style>

hide footbox
mainframe Register Account

actor Guest as act
participant "RegisterPage" as view
participant "VerifyOtpPage" as r_view
participant "AuthController" as ctrl <<controller>>
participant ":AuthService" as svc
participant ":PasswordEncoder" as encoder
participant ":EmailService" as email_svc
participant ":User" as ett
participant ":EmailVerificationToken" as token
participant ":UserRepository" as user_repo
participant ":RoleRepository" as role_repo
participant ":EmailVerificationTokenRepository" as token_repo
database Database as db

act ++

act -> view++:1. Submit registration form
view -> ctrl++:2. POST /register

ctrl -> ctrl++:3. Validate BindingResult
ctrl--
opt BindingResult has errors
    ctrl -->> view:3.1. Return "authentication/register"
    view -->> act:3.1.1. Display validation error message
end

ctrl -> svc++:4. registerUser(requestDTO)

svc -> user_repo++:5. existsByEmail(email)
user_repo -> db++:6. Execute query
db -->> user_repo:7. Return boolean result
db--
user_repo -->> svc:8. Return exists
user_repo--

svc -> svc++:9. Validate registration details
svc--
alt Email already exists
    svc -->> ctrl:9.1. throw IllegalArgumentException
    ctrl -->> view:9.1.1. Return "authentication/register"
    view -->> act:9.1.2. Display error message
else Passwords do not match
    svc -->> ctrl:9.2. throw IllegalArgumentException
    ctrl -->> view:9.2.1. Return "authentication/register"
    view -->> act--:9.2.2. Display error message
else Valid registration details
    svc -> encoder++:9.3. encode(password)
    encoder -->> svc--:9.3.1. Return encodedPassword

    svc -> ett++:9.3.2. Call User(requestDTO, encodedPassword)
    ett -->> svc--:9.3.3. Return User entity

    svc -> role_repo++:9.3.4. findByName("ROLE_MEMBER")
    role_repo -> db++:9.3.5. Execute query
    db -->> role_repo:9.3.6. Return Role entity
    db--
    role_repo -->> svc:9.3.7. Return Role entity
    role_repo--

    svc -> user_repo++:9.3.8. save(user)
    user_repo -> db++:9.3.9. Save changes to database
    db -->> user_repo:9.3.10. Return saved user
    db--
    user_repo -->> svc:9.3.11. Return saved user
    user_repo--

    svc -> svc++:9.3.12. Generate 6-digit OTP code
    svc--

    svc -> token++:9.3.13. Call EmailVerificationToken(user, otp)
    token -->> svc--:9.3.14. Return token entity

    svc -> token_repo++:9.3.15. save(token)
    token_repo -> db++:9.3.16. Save changes to database
    db -->> token_repo:9.3.17. Return saved token
    db--
    token_repo -->> svc:9.3.18. Return saved token
    token_repo--

    svc -> email_svc++:9.3.19. sendOtpEmail(email, otp)
    email_svc -->> svc--:9.3.20. Return result

    svc -->> ctrl--:9.3.21. Return result

    ctrl -->> r_view--:9.3.22. Redirect to /verify-otp
    activate r_view
    r_view -->> act--:9.3.23. Display OTP verification page
end

@enduml
