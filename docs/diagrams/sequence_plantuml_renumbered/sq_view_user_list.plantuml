@startuml sq_view_user_list
<style>
    sequenceDiagram{
        FontSize 16
        LineColor black

        arrow {
            ' Set the maximum width of the text on arrows
            MaximumWidth 300
            LineColor black
        }
        actor{
            BackgroundColor white
            LineColor black
            LineThickness 1.0
        }
        participant{
            BackgroundColor white
            LineColor black
            RoundCorner 0
        }
        database{
            BackgroundColor white
            LineColor black
        }
        lifeLine{
            LineColor black
        }
        group{
            LineColor black
        }
        groupHeader{
            BackgroundColor white
            LineColor black
        }
        referenceHeader{
            BackgroundColor white
            LineColor black
        }
        reference{
            BackgroundColor white
            LineColor black
        }
    }
</style>

hide footbox
mainframe View User List (UC-49)

actor Admin as adm
participant "UserListPage" as view
participant "UserAdminController" as ctrl <<controller>>
participant ":UserManagementService" as svc
participant ":UserRepository" as user_repo
participant ":SystemAuditLogRepository" as audit_repo
database Database as db

adm ++

adm -> view++:1. Select filter (role, status, keyword) and click "Tìm kiếm"
view -> ctrl--:2. GET /admin/users?keyword=kw&role=r&status=st&page=0
activate ctrl

ctrl -> svc++:3. getUsers(keyword, role, status, 0, 7)

svc -> user_repo++:4. searchUsers(keyword, keywordId, role, status, pageable)
user_repo -> db++:5. Execute search query with filters
db -->> user_repo:6. Return user page
db--
user_repo -->> svc:7. Return user page
user_repo--

opt Page contains banned users (bannedUserIds not empty)
    svc -> audit_repo++:7.1. findByTargetEntityAndActionTypeAndTargetIdInOrderByCreatedAtDesc("USERS", "BAN_USER", bannedUserIds)
    audit_repo -> db++:7.1.1. Execute query
    db -->> audit_repo:7.1.2. Return ban audit logs
    db--
    audit_repo -->> svc:7.1.3. Return ban audit logs
    audit_repo--
end

svc -->> ctrl--:8. Return Page~UserManagementDTO~

ctrl -> svc++:9. getUserStats()

svc -> user_repo++:10. count()
user_repo -> db++:11. Execute query
db -->> user_repo:12. Return total count
db--
user_repo -->> svc:13. Return total users
user_repo--

svc -> user_repo++:14. countByStatus("ACTIVE")
user_repo -> db++:15. Execute query
db -->> user_repo:16. Return active count
db--
user_repo -->> svc:17. Return active count
user_repo--

svc -> user_repo++:18. countByStatus("BANNED")
user_repo -> db++:19. Execute query
db -->> user_repo:20. Return banned count
db--
user_repo -->> svc:21. Return banned count
user_repo--

svc -->> ctrl--:22. Return userStatsDTO

ctrl -->> view--:23. Return "admin/users/list"
deactivate ctrl
activate view
view -->> adm--:24. Display user management table and statistics cards
deactivate view

deactivate adm

@enduml
