classDiagram
direction LR

class BookshelfController {
    <<controller>>
    - bookshelfService : BookshelfService
    + removeNovelFromBookshelf(novelId: Integer, source: String, authentication: Authentication, redirectAttributes: RedirectAttributes) String
    + toggleBookshelfAjax(novelId: Integer, authentication: Authentication) ResponseEntity~?~
}

class BookshelfService {
    <<service interface>>
    + removeNovelFromBookshelf(email: String, novelId: Integer) void*
}

class BookshelfServiceImpl {
    <<service>>
    - bookshelfRepository : BookshelfRepository
    - userRepository : UserRepository
    - novelRepository : NovelRepository
    + removeNovelFromBookshelf(email: String, novelId: Integer) void
    - getUserByEmail(email: String) User
    - getNovelById(id: Integer) Novel
}

class BookshelfRepository {
    <<repository>>
    + findByUserAndNovel(user: User, novel: Novel) Optional~Bookshelf~*
    + delete(bookshelf: Bookshelf) void*
}

class UserRepository {
    <<repository>>
    + findByEmail(email: String) Optional~User~*
}

class NovelRepository {
    <<repository>>
    + findByIdAndIsDeletedFalse(id: Integer) Optional~Novel~*
}

class Bookshelf {
    <<entity>>
    - id : Integer
    - user : User
    - novel : Novel
    - addedAt : LocalDateTime
}

class User {
    <<entity>>
    - id : Integer
    - email : String
    - fullName : String
}

class Novel {
    <<entity>>
    - id : Integer
    - title : String
    - slug : String
}

BookshelfController --> BookshelfService
BookshelfServiceImpl ..|> BookshelfService

BookshelfServiceImpl --> BookshelfRepository
BookshelfServiceImpl --> UserRepository
BookshelfServiceImpl --> NovelRepository

Bookshelf --> User
Bookshelf --> Novel

classDef default fill:#FFFFFF,stroke:#000000,stroke-width:1px,color:#000000
