classDiagram
    direction LR

    class UserController {
        <<controller>>
        ⠀
        ⠀⠀
        - dailyCheckinService : DailyCheckinService
        + viewCheckin(authentication: Authentication, model: Model) String
        + getCheckinStatusApi(authentication: Authentication) ResponseEntity~DailyCheckinStatusDTO~
        + performCheckin(authentication: Authentication, request: HttpServletRequest, redirectAttributes: RedirectAttributes) Object
    }

    class DailyCheckinService {
        <<service interface>>
        ⠀
        ⠀⠀
        + getCheckinStatus(email: String) DailyCheckinStatusDTO*
        + performCheckin(email: String) DailyCheckinResultDTO*
    }

    class DailyCheckinServiceImpl {
        <<service>>
        ⠀
        ⠀⠀
        - userRepository : UserRepository
        - userDailyCheckinRepository : UserDailyCheckinRepository
        - walletService : WalletService
        + getCheckinStatus(email: String) DailyCheckinStatusDTO
        + performCheckin(email: String) DailyCheckinResultDTO
        - buildRoadmap(currentCycleDay: int, isCheckedInToday: boolean) List~DayRoadmapItemDTO~
    }

    class WalletService {
        <<service interface>>
        ⠀
        ⠀⠀
        + addCoins(user: User, amount: int, transactionType: String, referenceId: Integer, description: String) void*
        + getBalance(email: String) int*
    }

    class WalletServiceImpl {
        <<service>>
        ⠀
        ⠀⠀
        - userRepository : UserRepository
        - transactionRepository : TransactionRepository
        + addCoins(user: User, amount: int, transactionType: String, referenceId: Integer, description: String) void
        + getBalance(email: String) int
    }

    class DailyCheckinStatusDTO {
        <<dto>>
        ⠀
        ⠀⠀
        - serverDate : String
        - weekNumber : Integer
        - year : Integer
        - totalCheckinDays : Long
        - streakCount : Integer
        - currentStreakDay : Integer
        - todayReward : Integer
        - isCheckedInToday : Boolean
        - walletBalance : Integer
        - totalRewardCoins : Integer
        - roadmap : List~DayRoadmapItemDTO~
    }

    class DayRoadmapItemDTO {
        <<dto>>
        ⠀
        ⠀⠀
        - dayNumber : Integer
        - rewardCoin : Integer
        - status : String
        - label : String
        - isSpecial : Boolean
    }

    class DailyCheckinResultDTO {
        <<dto>>
        ⠀
        ⠀⠀
        - success : boolean
        - rewardCoin : Integer
        - streakCount : Integer
        - newBalance : Integer
        - message : String
    }

    class UserRepository {
        <<repository>>
        ⠀
        ⠀⠀
        + findByEmail(email: String) Optional~User~*
        + findByIdWithLock(id: Integer) Optional~User~*
        + save(user: User) User*
    }

    class UserDailyCheckinRepository {
        <<repository>>
        ⠀
        ⠀⠀
        + findByUserAndCheckinDate(user: User, checkinDate: LocalDate) Optional~UserDailyCheckin~*
        + findTopByUserOrderByCheckinDateDesc(user: User) Optional~UserDailyCheckin~*
        + existsByUserAndCheckinDate(user: User, checkinDate: LocalDate) boolean*
        + countByUser(user: User) long*
        + sumRewardCoinByUser(user: User) Long*
        + save(checkin: UserDailyCheckin) UserDailyCheckin*
    }

    class TransactionRepository {
        <<repository>>
        ⠀
        ⠀⠀
        + save(transaction: Transaction) Transaction*
    }

    class UserDailyCheckin {
        <<entity>>
        ⠀
        ⠀⠀
        - id : Integer
        - user : User
        - checkinDate : LocalDate
        - rewardCoin : Integer
        - streakCount : Integer
        - createdAt : LocalDateTime
    }

    class Transaction {
        <<entity>>
        ⠀
        ⠀⠀
        - id : Integer
        - user : User
        - amount : Integer
        - balanceAfter : Integer
        - type : String
        - referenceId : Integer
        - description : String
    }

    class User {
        <<entity>>
        ⠀
        ⠀⠀
        - id : Integer
        - email : String
        - fullName : String
        - walletBalance : Integer
    }

    UserController --> DailyCheckinService
    UserController ..> DailyCheckinStatusDTO
    UserController ..> DailyCheckinResultDTO
    DailyCheckinServiceImpl ..|> DailyCheckinService
    WalletServiceImpl ..|> WalletService
    DailyCheckinService ..> DailyCheckinStatusDTO
    DailyCheckinService ..> DailyCheckinResultDTO
    DailyCheckinServiceImpl --> UserRepository
    DailyCheckinServiceImpl --> UserDailyCheckinRepository
    DailyCheckinServiceImpl --> WalletService
    DailyCheckinServiceImpl ..> DailyCheckinStatusDTO
    DailyCheckinServiceImpl ..> DayRoadmapItemDTO
    DailyCheckinServiceImpl ..> DailyCheckinResultDTO
    DailyCheckinServiceImpl ..> UserDailyCheckin
    DailyCheckinServiceImpl ..> User
    WalletServiceImpl --> UserRepository
    WalletServiceImpl --> TransactionRepository
    WalletServiceImpl ..> User
    WalletServiceImpl ..> Transaction
    WalletService ..> User
    DailyCheckinStatusDTO --> DayRoadmapItemDTO
    UserRepository ..> User
    UserDailyCheckinRepository ..> UserDailyCheckin
    UserDailyCheckinRepository ..> User
    TransactionRepository ..> Transaction
    UserDailyCheckin --> User
    Transaction --> User

    classDef default fill:#FFFFFF,stroke:#000000,stroke-width:1px,color:#000000
