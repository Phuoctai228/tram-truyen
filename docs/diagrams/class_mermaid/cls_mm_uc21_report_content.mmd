classDiagram
direction LR

class ReportController["<<controller>> ReportController"] {
    - reportService : ReportService
    - userRepository : UserRepository
    + reportContent(request: ReportContentRequest, bindingResult: BindingResult, authentication: Authentication) ResponseEntity~?~
    - isAuthenticated(authentication: Authentication) boolean
    - getUserId(authentication: Authentication) Integer
}

class ReportService["<<service interface>> ReportService"] {
    + reportContent(userId: Integer, request: ReportContentRequest) void*
}

class ReportServiceImpl["<<service>> ReportServiceImpl"] {
    - chapterRepository : ChapterRepository
    - contentReportRepository : ContentReportRepository
    - userRepository : UserRepository
    + reportContent(userId: Integer, request: ReportContentRequest) void
}

class ContentReportRepository["<<repository>> ContentReportRepository"] {
    + existsByUserIdAndChapterIdAndStatusIn(userId: Integer, chapterId: Integer, statuses: Collection~String~) boolean*
    + save(report: ContentReport) ContentReport*
}

class ChapterRepository["<<repository>> ChapterRepository"] {
    + findById(id: Integer) Optional~Chapter~*
}

class UserRepository["<<repository>> UserRepository"] {
    + findById(id: Integer) Optional~User~*
    + findByEmail(email: String) Optional~User~*
}

class ReportContentRequest["<<dto>> ReportContentRequest"] {
    - chapterId : Integer
    - issueType : String
    - description : String
}

class ContentReport["<<entity>> ContentReport"] {
    - id : Integer
    - user : User
    - chapter : Chapter
    - reason : String
    - status : String
    - adminNote : String
    - resolver : User
    - createdAt : LocalDateTime
    - processedAt : LocalDateTime
}

class Chapter["<<entity>> Chapter"] {
    - id : Integer
    - chapterNumber : Integer
    - title : String
    - content : String
    - status : String
    - isDeleted : Boolean
}

class User["<<entity>> User"] {
    - id : Integer
    - email : String
    - fullName : String
    - status : String
}

ReportController --> ReportService
ReportController --> UserRepository
ReportServiceImpl ..|> ReportService

ReportServiceImpl --> ContentReportRepository
ReportServiceImpl --> ChapterRepository
ReportServiceImpl --> UserRepository

ReportController ..> ReportContentRequest
ReportService ..> ReportContentRequest
ReportServiceImpl ..> ReportContentRequest
ReportServiceImpl ..> ContentReport

ContentReport --> User
ContentReport --> Chapter

