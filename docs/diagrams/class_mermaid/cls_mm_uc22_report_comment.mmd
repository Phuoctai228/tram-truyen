classDiagram
direction LR

class ReportController["<<controller>> ReportController"] {
    - reportService : ReportService
    - userRepository : UserRepository
    + reportComment(request: ReportCommentRequest, bindingResult: BindingResult, authentication: Authentication) ResponseEntity~?~
    - isAuthenticated(authentication: Authentication) boolean
    - getUserId(authentication: Authentication) Integer
}

class ReportService["<<service interface>> ReportService"] {
    + reportComment(userId: Integer, request: ReportCommentRequest) void*
}

class ReportServiceImpl["<<service>> ReportServiceImpl"] {
    - commentRepository : CommentRepository
    - commentReportRepository : CommentReportRepository
    - userRepository : UserRepository
    + reportComment(userId: Integer, request: ReportCommentRequest) void
}

class CommentReportRepository["<<repository>> CommentReportRepository"] {
    + existsByUserIdAndCommentIdAndStatusIn(userId: Integer, commentId: Integer, statuses: Collection~String~) boolean*
    + save(report: CommentReport) CommentReport*
}

class CommentRepository["<<repository>> CommentRepository"] {
    + findById(id: Integer) Optional~Comment~*
}

class UserRepository["<<repository>> UserRepository"] {
    + findById(id: Integer) Optional~User~*
    + findByEmail(email: String) Optional~User~*
}

class ReportCommentRequest["<<dto>> ReportCommentRequest"] {
    - commentId : Integer
    - violationType : String
    - description : String
}

class CommentReport["<<entity>> CommentReport"] {
    - id : Integer
    - user : User
    - comment : Comment
    - reason : String
    - status : String
    - adminNote : String
    - resolver : User
    - createdAt : LocalDateTime
    - processedAt : LocalDateTime
}

class Comment["<<entity>> Comment"] {
    - id : Integer
    - user : User
    - content : String
    - status : String
    - createdAt : LocalDateTime
    - updatedAt : LocalDateTime
}

class User["<<entity>> User"] {
    - id : Integer
    - email : String
    - fullName : String
    - status : String
}

ReportController --> ReportService
ReportController --> UserRepository
ReportServiceImpl ..|> ReportService

ReportServiceImpl --> CommentReportRepository
ReportServiceImpl --> CommentRepository
ReportServiceImpl --> UserRepository

ReportController ..> ReportCommentRequest
ReportService ..> ReportCommentRequest
ReportServiceImpl ..> ReportCommentRequest
ReportServiceImpl ..> CommentReport

CommentReport --> User
CommentReport --> Comment
Comment --> User

