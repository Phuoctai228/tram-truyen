classDiagram
direction LR

class NovelController {
    <<controller>>
    - chapterUnlockService : ChapterUnlockService
    - novelService : NovelService
    - chapterService : ChapterService
    + unlockChapter(slug: String, chapterNumber: Integer, autoUnlockNext: Boolean, authentication: Authentication, request: HttpServletRequest, redirectAttributes: RedirectAttributes) Object
}

class ChapterUnlockService {
    <<service interface>>
    + isChapterUnlocked(email: String, chapterId: Integer) boolean*
    + unlockChapter(email: String, chapterId: Integer, autoUnlockNext: Boolean) UnlockResultDTO*
}

class ChapterUnlockServiceImpl {
    <<service>>
    - userRepository : UserRepository
    - chapterRepository : ChapterRepository
    - userChapterActivityRepository : UserChapterActivityRepository
    - walletService : WalletService
    - chapterAccessPolicy : ChapterAccessPolicy
    + isChapterUnlocked(email: String, chapterId: Integer) boolean
    + unlockChapter(email: String, chapterId: Integer, autoUnlockNext: Boolean) UnlockResultDTO
    - validateChapterEligibility(chapter: Chapter) void
    - buildTransactionDescription(chapter: Chapter) String
    - buildPrivilegedResult(chapter: Chapter, user: User, autoUnlockNext: Boolean) UnlockResultDTO
    - buildAlreadyUnlockedResult(chapter: Chapter, user: User, autoUnlockNext: Boolean) UnlockResultDTO
    - buildFreeResult(chapter: Chapter, user: User, autoUnlockNext: Boolean, existingOpt: Optional~UserChapterActivity~) UnlockResultDTO
    - markChapterUnlocked(user: User, chapter: Chapter, price: int, existingOpt: Optional~UserChapterActivity~) void
}

class WalletService {
    <<service interface>>
    + deductCoins(user: User, amount: int, transactionType: String, referenceId: Integer, description: String) void*
}

class ChapterAccessPolicy {
    + isPaid(chapter: Chapter) boolean
    + isPrivileged(roleNames: Set~String~) boolean
}

class UserRepository {
    <<repository>>
    + findByEmail(email: String) Optional~User~*
    + findByEmailWithLock(email: String) Optional~User~*
}

class ChapterRepository {
    <<repository>>
    + findById(id: Integer) Optional~Chapter~*
}

class UserChapterActivityRepository {
    <<repository>>
    + findByUserAndChapter(user: User, chapter: Chapter) Optional~UserChapterActivity~*
    + save(activity: UserChapterActivity) UserChapterActivity*
}

class UnlockResultDTO {
    <<dto>>
    - success : boolean
    - chapterId : Integer
    - chapterNumber : Integer
    - chapterTitle : String
    - pricePaid : Integer
    - remainingBalance : Integer
    - autoUnlockNext : Boolean
    - message : String
}

class UserChapterActivity {
    <<entity>>
    - id : Integer
    - user : User
    - chapter : Chapter
    - isRead : Boolean
    - isUnlocked : Boolean
    - pricePaid : Integer
    - unlockedAt : LocalDateTime
}

class User {
    <<entity>>
    - id : Integer
    - email : String
    - walletBalance : Integer
}

class Chapter {
    <<entity>>
    - id : Integer
    - chapterNumber : Integer
    - title : String
    - price : Integer
    - status : String
    - isDeleted : Boolean
}

NovelController --> ChapterUnlockService
ChapterUnlockServiceImpl ..|> ChapterUnlockService

ChapterUnlockServiceImpl --> UserRepository
ChapterUnlockServiceImpl --> ChapterRepository
ChapterUnlockServiceImpl --> UserChapterActivityRepository
ChapterUnlockServiceImpl --> WalletService
ChapterUnlockServiceImpl --> ChapterAccessPolicy

NovelController ..> UnlockResultDTO
ChapterUnlockService ..> UnlockResultDTO
ChapterUnlockServiceImpl ..> UnlockResultDTO
ChapterUnlockServiceImpl ..> UserChapterActivity

UserChapterActivity --> User
UserChapterActivity --> Chapter

