classDiagram
direction LR

class BookshelfController {
    <<controller>>
    - bookshelfService : BookshelfService
    + viewBookshelf(filter: String, q: String, sort: String, page: int, authentication: Authentication, model: Model) String
    + tuSachAlias() String
}

class BookshelfService {
    <<service interface>>
    + getBookshelfPage(email: String, filter: String, query: String, sort: String, page: int, size: int) BookshelfPageDTO*
    + getUserProfile(email: String) UserProfileDTO*
}

class BookshelfServiceImpl {
    <<service>>
    - bookshelfRepository : BookshelfRepository
    - userRepository : UserRepository
    - novelRepository : NovelRepository
    - chapterRepository : ChapterRepository
    - categoryRepository : CategoryRepository
    - userChapterActivityRepository : UserChapterActivityRepository
    + getBookshelfPage(email: String, filter: String, query: String, sort: String, page: int, size: int) BookshelfPageDTO
    + getUserProfile(email: String) UserProfileDTO
    - mapToBookshelfItem(user: User, bookshelf: Bookshelf) BookshelfItemDTO
    - getUserByEmail(email: String) User
}

class BookshelfRepository {
    <<repository>>
    + findAllByUserWithNovel(user: User) List~Bookshelf~*
    + countByNovelId(novelId: Integer) long*
}

class ChapterRepository {
    <<repository>>
    + countByNovelIdAndIsDeletedFalse(novelId: Integer) long*
    + existsByNovelIdAndPriceGreaterThanAndIsDeletedFalse(novelId: Integer, price: Integer) boolean*
}

class UserChapterActivityRepository {
    <<repository>>
    + findFirstByUserAndChapter_NovelAndIsReadTrueOrderByReadAtDescChapter_ChapterNumberDesc(user: User, novel: Novel) Optional~UserChapterActivity~*
    + countByUserAndChapter_NovelAndIsReadTrue(user: User, novel: Novel) long*
}

class BookshelfPageDTO {
    <<dto>>
    - items : List~BookshelfItemDTO~
    - totalCount : long
    - readingCount : long
    - completedCount : long
    - currentPage : int
    - totalPages : int
    - pageSize : int
    - hasPrevious : boolean
    - hasNext : boolean
    - currentFilter : String
    - searchQuery : String
    - currentSort : String
    - popularCategories : List~Category~
}

class BookshelfItemDTO {
    <<dto>>
    - novelId : Integer
    - slug : String
    - title : String
    - author : String
    - coverUrl : String
    - status : String
    - categories : List~String~
    - totalChapters : int
    - currentChapterNumber : int
    - progressPercentage : int
    - isCompleted : boolean
    - isCaughtUp : boolean
    - hasVipChapters : boolean
    - addedAt : LocalDateTime
    - relativeTime : String
    - readUrl : String
}

class UserProfileDTO {
    <<dto>>
    - id : Integer
    - fullName : String
    - email : String
    - avatarUrl : String
    - walletBalance : Integer
    - createdAt : LocalDateTime
    - isEmailVerified : boolean
}

class Bookshelf {
    <<entity>>
    - id : Integer
    - user : User
    - novel : Novel
    - addedAt : LocalDateTime
}

class Novel {
    <<entity>>
    - id : Integer
    - title : String
    - slug : String
    - author : String
    - coverUrl : String
    - status : String
}

class User {
    <<entity>>
    - id : Integer
    - email : String
    - fullName : String
    - walletBalance : Integer
}

BookshelfController --> BookshelfService
BookshelfServiceImpl ..|> BookshelfService

BookshelfServiceImpl --> BookshelfRepository
BookshelfServiceImpl --> ChapterRepository
BookshelfServiceImpl --> UserChapterActivityRepository

BookshelfController ..> BookshelfPageDTO
BookshelfController ..> UserProfileDTO
BookshelfServiceImpl ..> BookshelfPageDTO
BookshelfPageDTO *-- BookshelfItemDTO

Bookshelf --> User
Bookshelf --> Novel

classDef default fill:#FFFFFF,stroke:#000000,stroke-width:1px,color:#000000
