classDiagram
    direction LR

    class UserController["<<controller>> UserController"] {
        - userService : UserService
        + UserController(userService: UserService)
        + viewChangePassword(authentication: Authentication) String
        + changePassword(authentication: Authentication, oldPassword: String, newPassword: String, redirectAttributes: RedirectAttributes) String
    }

    class UserService["<<service interface>> UserService"] {
        + changePassword(email: String, oldPassword: String, newPassword: String)* void
    }

    class UserServiceImpl["<<service>> UserServiceImpl"] {
        - userRepository : UserRepository
        - passwordEncoder : PasswordEncoder
        + UserServiceImpl(userRepository: UserRepository, mediaStorageService: MediaStorageService, passwordEncoder: PasswordEncoder)
        + changePassword(email: String, oldPassword: String, newPassword: String) void
    }

    class UserRepository["<<repository>> UserRepository"] {
        + findByEmail(email: String)* Optional~User~
        + save(user: User)* User
    }

    class User["<<entity>> User"] {
        - id : Integer
        - email : String
        - password : String
        - fullName : String
        - status : String
        - updatedAt : LocalDateTime
        + getId() Integer
        + setId(id: Integer) void
        + getEmail() String
        + setEmail(email: String) void
        + getPassword() String
        + setPassword(password: String) void
        + getFullName() String
        + setFullName(fullName: String) void
        + getStatus() String
        + setStatus(status: String) void
        + getUpdatedAt() LocalDateTime
        + setUpdatedAt(updatedAt: LocalDateTime) void
    }

    UserController --> UserService
    UserServiceImpl ..|> UserService
    UserServiceImpl --> UserRepository
    UserServiceImpl ..> User
    UserRepository ..> User

    classDef default fill:#FFFFFF,stroke:#000000,stroke-width:1px,color:#000000
