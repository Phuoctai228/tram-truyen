classDiagram
    direction LR

    class UserController["<<controller>> UserController"] {
        - bookshelfService : BookshelfService
        + UserController(bookshelfService: BookshelfService)
        + viewProfile(authentication: Authentication, model: Model) String
    }

    class BookshelfService["<<service interface>> BookshelfService"] {
        + getUserProfile(email: String)* UserProfileDTO
        + getUserBookshelf(email: String)* List~Bookshelf~
    }

    class BookshelfServiceImpl["<<service>> BookshelfServiceImpl"] {
        - bookshelfRepository : BookshelfRepository
        - userRepository : UserRepository
        + BookshelfServiceImpl(bookshelfRepository: BookshelfRepository, userRepository: UserRepository)
        + getUserProfile(email: String) UserProfileDTO
        + getUserBookshelf(email: String) List~Bookshelf~
    }

    class UserProfileDTO["<<dto>> UserProfileDTO"] {
        - id : Integer
        - fullName : String
        - email : String
        - avatarUrl : String
        - walletBalance : Integer
        - createdAt : LocalDateTime
        - isEmailVerified : boolean
        + getId() Integer
        + setId(id: Integer) void
        + getFullName() String
        + setFullName(fullName: String) void
        + getEmail() String
        + setEmail(email: String) void
        + getAvatarUrl() String
        + setAvatarUrl(avatarUrl: String) void
        + getWalletBalance() Integer
        + setWalletBalance(walletBalance: Integer) void
        + getCreatedAt() LocalDateTime
        + setCreatedAt(createdAt: LocalDateTime) void
        + isEmailVerified() boolean
        + setEmailVerified(isEmailVerified: boolean) void
    }

    class UserRepository["<<repository>> UserRepository"] {
        + findByEmail(email: String)* Optional~User~
    }

    class BookshelfRepository["<<repository>> BookshelfRepository"] {
        + findAllByUserWithNovel(user: User)* List~Bookshelf~
    }

    class User["<<entity>> User"] {
        - id : Integer
        - email : String
        - fullName : String
        - avatarUrl : String
        - walletBalance : Integer
        - status : String
        - createdAt : LocalDateTime
        + getId() Integer
        + setId(id: Integer) void
        + getEmail() String
        + setEmail(email: String) void
        + getFullName() String
        + setFullName(fullName: String) void
        + getAvatarUrl() String
        + setAvatarUrl(avatarUrl: String) void
        + getWalletBalance() Integer
        + setWalletBalance(walletBalance: Integer) void
        + getStatus() String
        + setStatus(status: String) void
        + getCreatedAt() LocalDateTime
        + setCreatedAt(createdAt: LocalDateTime) void
    }

    class Bookshelf["<<entity>> Bookshelf"] {
        - id : Integer
        - user : User
        - addedAt : LocalDateTime
        + getId() Integer
        + setId(id: Integer) void
        + getUser() User
        + setUser(user: User) void
        + getAddedAt() LocalDateTime
        + setAddedAt(addedAt: LocalDateTime) void
    }

    UserController --> BookshelfService
    UserController ..> UserProfileDTO
    BookshelfServiceImpl ..|> BookshelfService
    BookshelfServiceImpl --> UserRepository
    BookshelfServiceImpl --> BookshelfRepository
    BookshelfService ..> UserProfileDTO
    BookshelfService ..> Bookshelf
    BookshelfServiceImpl ..> UserProfileDTO
    BookshelfServiceImpl ..> User
    BookshelfServiceImpl ..> Bookshelf
    UserRepository ..> User
    BookshelfRepository ..> Bookshelf
    BookshelfRepository ..> User
    Bookshelf --> User

    classDef default fill:#FFFFFF,stroke:#000000,stroke-width:1px,color:#000000
