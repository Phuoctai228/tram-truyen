classDiagram
direction LR

class NotificationAdminController["<<controller>> NotificationAdminController"] {
    - notificationService : NotificationService
    - userRepository : UserRepository
    + showSendNotificationPage(page: String, size: String, model: Model) String
    + sendNotification(request: SendNotificationRequest, bindingResult: BindingResult, authentication: Authentication, httpRequest: HttpServletRequest, redirectAttributes: RedirectAttributes) String
    + searchRecipients(keyword: String) ResponseEntity~List~UserRecipientDTO~~
    - getAdminId(authentication: Authentication) Integer
    - getClientIp(request: HttpServletRequest) String
}

class NotificationService["<<service interface>> NotificationService"] {
    + sendNotification(senderAdminId: Integer, request: SendNotificationRequest, clientIp: String) void*
    + searchRecipients(keyword: String) List~UserRecipientDTO~*
    + getRecentNotifications(page: int, size: int) Page~NotificationDTO~*
}

class NotificationServiceImpl["<<service>> NotificationServiceImpl"] {
    - notificationRepository : NotificationRepository
    - userRepository : UserRepository
    - systemAuditLogRepository : SystemAuditLogRepository
    - objectMapper : ObjectMapper
    + sendNotification(senderAdminId: Integer, request: SendNotificationRequest, clientIp: String) void
    + searchRecipients(keyword: String) List~UserRecipientDTO~
    + getRecentNotifications(page: int, size: int) Page~NotificationDTO~
}

class NotificationRepository["<<repository>> NotificationRepository"] {
    + save(notification: Notification) Notification*
}

class SystemAuditLogRepository["<<repository>> SystemAuditLogRepository"] {
    + save(auditLog: SystemAuditLog) SystemAuditLog*
}

class UserRepository["<<repository>> UserRepository"] {
    + findById(id: Integer) Optional~User~*
    + findTop10ByFullNameContainingIgnoreCaseOrEmailContainingIgnoreCase(fullName: String, email: String) List~User~*
}

class SendNotificationRequest["<<dto>> SendNotificationRequest"] {
    - scope : String
    - recipientId : Integer
    - recipientName : String
    - recipientEmail : String
    - title : String
    - content : String
}

class UserRecipientDTO["<<dto>> UserRecipientDTO"] {
    - id : Integer
    - fullName : String
    - email : String
    - avatarUrl : String
}

class NotificationDTO["<<dto>> NotificationDTO"] {
    - id : Integer
    - userId : Integer
    - title : String
    - content : String
    - isRead : Boolean
    - createdAt : LocalDateTime
}

class Notification["<<entity>> Notification"] {
    - id : Integer
    - userId : Integer
    - title : String
    - content : String
    - isRead : Boolean
    - createdAt : LocalDateTime
}

class SystemAuditLog["<<entity>> SystemAuditLog"] {
    - id : Integer
    - adminId : Integer
    - actionType : String
    - targetEntity : String
    - targetId : Integer
    - oldValue : String
    - newValue : String
    - ipAddress : String
    - createdAt : LocalDateTime
}

class User["<<entity>> User"] {
    - id : Integer
    - email : String
    - fullName : String
}

